          "settings": {
            "question": "How do I choose the right size?",
            "answer": "<p>Please refer to the individual size guide provided on each product page before ordering. As the fit may vary slightly between styles, we recommend checking the measurements for the particular garment you are considering. If you’re unsure, please contact us before ordering and we’ll be happy to help.</p>"
          }
        },
        "g2q2": {
          "type": "question",
          "settings": {
            "question": "How should I care for my Maison Cavallé pieces?",
            "answer": "<p>Each garment has been selected with quality and longevity in mind. Always follow the care instructions on the garment label. Where appropriate, we recommend gentle washing, avoiding harsh detergents and allowing garments to air dry to help preserve their shape, colour and finish.</p>"
          }
        },
        "g2q3": {
          "type": "question",
          "settings": {
            "question": "Will sold-out items be restocked?",
            "answer": "<p>Maison Cavallé collections may be produced in considered quantities rather than continuously mass-produced. Selected pieces may be restocked depending on demand and availability. We recommend joining our mailing list and following Maison Cavallé on Instagram for restock announcements and new collection releases.</p>"
          }
        },
