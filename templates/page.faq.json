        "g1q1": {
          "type": "question",
          "settings": {
            "question": "What is Maison Cavallé?",
            "answer": "<p>Maison Cavallé is an Australian boutique equestrian apparel brand born from more than fifty years of life with horses. Our collections combine genuine equestrian heritage with considered design, quality fabrics and timeless style — creating pieces designed to be worn and loved both in and beyond the saddle.</p>"
          }
        },
        "g1q2": {
          "type": "question",
          "settings": {
            "question": "What does Maison Cavallé mean?",
            "answer": "<p>The name is deeply personal to our story. MC represents the initials of our founder, Miriam Claire, while Maison Cavallé reflects the idea of a House of Horse — a home for equestrian clothing shaped by heritage, quality and a lifelong connection with horses.</p>"
          }
        },
        "g1q3": {
          "type": "question",
          "settings": {
            "question": "Where is Maison Cavallé based?",
            "answer": "<p>Maison Cavallé is based in Queensland, Australia.</p>"
