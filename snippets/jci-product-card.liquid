{% comment %}
  Maison Cavallé — product card
  Prototype source: maison-cavalle-main/app.js → productCard()
                    maison-cavalle-main/styles.css → .product-card and friends
  Reference: MAISON-CAVALLE-SPEC.md §1, §7

  Accepts:
    product          - product object (required)
    subtitle_key     - "namespace.key" metafield holding the short descriptor
    badge_text       - text for the badge when the product is not on sale
    badge_source     - "none" | "sale" | "always"
    section_id       - the calling section's id, used for the form id and for
                       Horizon's section-aware cart refresh
    swatch_option    - option name to read colour swatches from, e.g. "Color"
    swatch_metafield - "namespace.key" holding "Name:#hex | Name:#hex" pairs,
                       used only where an option value carries no native swatch
    show_quick_add   - boolean
    quick_add_label  - visible button text
    image_index      - which product image to show, 0-based
    lazy             - boolean, false for above-the-fold cards

  A single-variant product adds straight to cart. Anything with choices opens
  Horizon's quick-add modal, so the shopper picks the variant rather than
  having one guessed for them.
{% endcomment %}

{% liquid
  assign image_index = image_index | default: 0
  assign card_image = product.images[image_index] | default: product.featured_image

  assign subtitle = blank
  if subtitle_key != blank
    assign subtitle_parts = subtitle_key | split: '.'
    assign subtitle = product.metafields[subtitle_parts[0]][subtitle_parts[1]].value
  endif
  if subtitle == blank
    assign subtitle = product.type
  endif

  assign on_sale = false
  if product.compare_at_price > product.price
    assign on_sale = true
  endif

  assign badge = blank
  case badge_source
    when 'sale'
      if on_sale
        assign badge = badge_text | default: 'Sale'
      endif
    when 'always'
      assign badge = badge_text
  endcase

  assign swatch_values = blank
  if swatch_option != blank
    assign swatch_values = product.options_by_name[swatch_option].values
  endif

  comment
    Shopify's native option-value swatch is the real source. Where a store has
    not linked its option values to colour-pattern entries, `value.swatch` is
    empty, so a metafield of "Name:#hex | Name:#hex" pairs stands in. Native
    always wins, so setting the real swatches later needs no change here.
  endcomment
  assign swatch_pairs = blank
  if swatch_metafield != blank
    assign swatch_mf_parts = swatch_metafield | split: '.'
    assign swatch_raw = product.metafields[swatch_mf_parts[0]][swatch_mf_parts[1]].value
    if swatch_raw != blank
      assign swatch_pairs = swatch_raw | split: '|'
    endif
  endif

  comment
    Three shapes, matching Horizon's own quick-add:
      add    - one variant, so it posts straight to the cart
      choose - more than one, so Horizon's modal picks the variant
      soldout- nothing to add, so the button renders disabled
    Selling plans are handed to quick-add-component, which sends those to the
    product page since subscription widgets only run there.
  endcomment
  assign quick_add_variant = blank
  assign quick_add_mode = 'none'
  assign quick_add_purchasable = false
  assign quick_add_selling_plans = false

  if product.requires_selling_plan or product.selling_plan_groups.size > 0
    assign quick_add_selling_plans = true
  endif

  if show_quick_add
    if product.available == false
      assign quick_add_mode = 'soldout'
    elsif product.variants.size == 1
      assign quick_add_mode = 'add'
      assign quick_add_variant = product.selected_or_first_available_variant
      assign quick_add_purchasable = quick_add_variant.available
    else
      assign quick_add_mode = 'choose'
    endif
  endif

  comment
    Horizon's add-to-cart component preloads this on hover for its fly-to-cart
    animation, and `product-form-component` needs a unique form id per card.
  endcomment
  assign quick_add_form_id = 'jci-quick-add-' | append: section_id | append: '-' | append: product.id
  assign quick_add_media = quick_add_variant.featured_media.preview_image | image_url: width: 100
  if quick_add_media == blank
    assign quick_add_media = product.featured_media.preview_image | image_url: width: 100
  endif
%}

{%- comment -%}
  Horizon's <product-card> is the root: quick-add-component takes the product
  URL from it, and ProductCard prefetches the product page on hover so the
  quick-add modal opens without a fetch wait. It needs one ref -
  productCardLink - and no-ops its own card-click navigation unless that link
  carries an id, so our own link behaviour is untouched.
{%- endcomment -%}
<product-card class="jci-product-card">
  <div class="jci-product-card-media">
    <a
      class="jci-product-card-link"
      ref="productCardLink"
      href="{{ product.url }}"
      aria-label="{{ product.title | escape }}"
    >
      {%- if badge != blank -%}
        <span class="jci-product-card-badge">{{ badge }}</span>
      {%- endif -%}

      {%- if card_image != blank -%}
        <img
          class="jci-product-card-image"
          src="{{ card_image | image_url: width: 800 }}"
          srcset="
            {{ card_image | image_url: width: 400 }} 400w,
            {{ card_image | image_url: width: 600 }} 600w,
            {{ card_image | image_url: width: 800 }} 800w
          "
          sizes="(max-width: 680px) 50vw, 25vw"
          alt="{{ card_image.alt | escape | default: product.title | escape }}"
          width="{{ card_image.width }}"
          height="{{ card_image.height }}"
          loading="{% if lazy == false %}eager{% else %}lazy{% endif %}"
        >
      {%- else -%}
        {%- comment -%}
          A product with no image yet still shows a garment outline rather
          than an empty block, the same placeholder the section uses when no
          collection is chosen.
        {%- endcomment -%}
        {{ 'product-apparel-1' | placeholder_svg_tag: 'jci-product-card-image jci-product-card-placeholder' }}
      {%- endif -%}
    </a>

    {%- if show_quick_add and quick_add_mode != 'none' -%}
      {%- comment -%}
        The whole button is Horizon's: `quick-add-component` carries the
        choose -> modal path, `product-form-component` posts the add without a
        reload, and `add-to-cart-button` brings the refs, the disabled state
        and the checkmark burst that `animateAddToCart()` drives off
        `[data-added]`. Our own markup had none of that last part, which is why
        an add looked like nothing had happened.

        Only the label is ours. It is passed through `add_to_cart_text` as
        markup so the mockup's text span and bag icon survive inside Horizon's
        button — the mobile card hides the span and shows the icon (§1).
      {%- endcomment -%}
      {%- capture quick_add_inner -%}
        <span class="jci-product-card-quick-add-text add-to-cart-text">
          {{- quick_add_label }} <span class="jci-product-card-quick-add-plus" aria-hidden="true">{{- 'icon-plus.svg' | inline_asset_content -}}</span>
        </span>
        {%- render 'jci-product-card-bag-icon' -%}
      {%- endcapture -%}

      <div class="jci-product-card-quick-add">
        <quick-add-component
          class="jci-product-card-quick-add-component"
          ref="quickAdd"
          data-product-title="{{ product.title | escape }}"
          data-product-id="{{ product.id }}"
          data-quick-add-button="{% if quick_add_mode == 'choose' %}choose{% else %}add{% endif %}"
          data-product-options-count="{{ product.options.size }}"
          data-uses-selling-plans="{{ quick_add_selling_plans }}"
        >
          {%- if quick_add_mode == 'choose' -%}
            <button
              class="jci-product-card-quick-add-button add-to-cart-button"
              type="button"
              name="add"
              on:click="quick-add-component/handleClick"
              aria-label="{{ 'actions.show_all_options' | t }} — {{ product.title | escape }}"
            >
              {{ quick_add_inner }}
            </button>
          {%- else -%}
            <product-form-component
              class="jci-product-card-form"
              data-section-id="{{ section_id }}"
              data-product-id="{{ product.id }}"
              on:submit="/handleSubmit"
            >
              <div
                class="jci-product-card-live-region"
                aria-live="assertive"
                role="status"
                aria-atomic="true"
                ref="liveRegion"
              ></div>

              {%- form 'product', product, id: quick_add_form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
                <input
                  type="hidden"
                  name="id"
                  ref="variantId"
                  value="{{ quick_add_variant.id }}"
                  {% if quick_add_purchasable == false %}disabled{% endif %}
                >
                <input type="hidden" name="quantity" value="1">

                {%- render 'add-to-cart-button',
                  add_to_cart_text: quick_add_inner,
                  class: 'jci-product-card-quick-add-button add-to-cart-button',
                  can_add_to_cart: quick_add_purchasable,
                  show_icon: false,
                  product: product
                -%}
              {%- endform -%}
            </product-form-component>
          {%- endif -%}
        </quick-add-component>
      </div>

      {%- comment -%} Carries the [data-added] feedback our button now uses. {%- endcomment -%}
      {%- render 'add-to-cart-button-styles' -%}
    {%- endif -%}
  </div>

  <div class="jci-product-card-info">
    <div class="jci-product-card-details">
      <h3 class="jci-product-card-title">
        <a class="jci-product-card-title-link" href="{{ product.url }}">{{ product.title }}</a>
      </h3>

      {%- comment -%}
        Rendered even when empty: styles.css:305 reserves 2.7em here, and
        without it the price rides up level with the next card's title.
      {%- endcomment -%}
      <p class="jci-product-card-subtitle">{{ subtitle }}</p>

      {%- if swatch_values != blank -%}
        <div class="jci-product-card-swatches">
          {%- for value in swatch_values -%}
            {%- liquid
              assign swatch_color = value.swatch.color

              if swatch_color == blank and swatch_pairs != blank
                capture value_name
                  echo value
                endcapture
                assign value_name = value_name | strip | downcase

                for pair in swatch_pairs
                  assign pair_parts = pair | split: ':'
                  assign pair_name = pair_parts[0] | strip | downcase
                  if pair_name == value_name
                    assign swatch_color = pair_parts[1] | strip
                    break
                  endif
                endfor
              endif
            -%}
            {%- if swatch_color != blank -%}
              <span
                class="jci-product-card-swatch"
                style="--jci-product-card-swatch-color: {{ swatch_color }};"
                title="{{ value | escape }}"
              ></span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <span class="jci-product-card-price">
      {{- product.price | money -}}
      {%- if on_sale -%}
        <s class="jci-product-card-price-was">{{ product.compare_at_price | money }}</s>
      {%- endif -%}
    </span>
  </div>
</product-card>
