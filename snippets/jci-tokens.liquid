{% doc %}
  Emits the Maison Cavallé palette entries as CSS custom properties.

  Horizon's own `color-palette` snippet only outputs `background` and
  `foreground`; `color1`–`color7` exist in theme settings but never reach CSS.
  This snippet exposes them so sections can reference palette colours by role
  instead of hardcoding hex values.

  Render from layout/theme.liquid after 'color-palette'.
  Reference: MAISON-CAVALLE-SPEC.md §2
{% enddoc %}

{% liquid
  assign paper = settings.color_palette.background
  assign ink = settings.color_palette.foreground
  assign ink_soft = settings.color_palette.color1
  assign sand = settings.color_palette.color2
  assign cream = settings.color_palette.color3
  assign stone = settings.color_palette.color4
  assign olive = settings.color_palette.color5
  assign rust = settings.color_palette.color6
  assign hero_accent = settings.color_palette.color7
%}

{% style %}
  :root {
    --jci-paper: {{ paper }};
    --jci-paper-rgb: {{ paper.rgb }};
    --jci-ink: {{ ink }};
    --jci-ink-rgb: {{ ink.rgb }};
    --jci-ink-soft: {{ ink_soft }};
    --jci-ink-soft-rgb: {{ ink_soft.rgb }};
    --jci-sand: {{ sand }};
    --jci-sand-rgb: {{ sand.rgb }};
    --jci-cream: {{ cream }};
    --jci-cream-rgb: {{ cream.rgb }};
    --jci-stone: {{ stone }};
    --jci-stone-rgb: {{ stone.rgb }};
    --jci-olive: {{ olive }};
    --jci-olive-rgb: {{ olive.rgb }};
    --jci-rust: {{ rust }};
    --jci-rust-rgb: {{ rust.rgb }};
    --jci-hero-accent: {{ hero_accent }};
    --jci-hero-accent-rgb: {{ hero_accent.rgb }};
  }
{% endstyle %}
