{% comment %}
  Maison Cavallé — journal hero

  Prototype source: maison-cavalle-main/app.js      → renderJournalPage,
                                                      section.journal-hero
                    maison-cavalle-main/styles.css  → .journal-hero (1265-1291)
  Reference: MAISON-CAVALLE-SPEC.md §0, §1, §3, §5, §7

  The prototype builds every page hero from one `.journal-hero` base and adds a
  per-page modifier (story, contact, size). This theme keeps them as separate
  sections instead, one per page, so each carries only its own settings — see
  the consistency note in the spec about consolidating them later.

  The meta row under the copy is block-driven, so a hero with no meta blocks
  (the journal's) simply does not render one.

  No letter-spacing or line-height is authored (§0).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign meta = section.blocks | where: 'type', 'meta'

  assign feature_image = s.image
  assign image_asset = s.image_asset | strip
-%}

<section
  class="jci-journal-hero"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  {{ section.shopify_attributes }}
  style="
    --jci-journal-hero-bg: {{ s.background_color | default: settings.color_palette.foreground }};
    --jci-journal-hero-text: {{ s.text_color | default: settings.color_palette.background }};
    --jci-journal-hero-accent: {{ s.accent_color | default: settings.color_palette.color7 }};
    --jci-journal-hero-meta: {% if s.meta_color != blank %}{{ s.meta_color }}{% else %}rgb(var(--jci-paper-rgb) / 0.7){% endif %};
    --jci-journal-hero-body: {% if s.body_color != blank %}{{ s.body_color }}{% else %}rgb(var(--jci-paper-rgb) / 0.82){% endif %};
    --jci-journal-hero-frame: {{ s.frame_background | default: settings.color_palette.color1 }};
    --jci-journal-hero-min-height: {{ s.min_height }}px;
    --jci-journal-hero-pad-top: {% render 'jci-fluid-space', max: s.padding_top, min: s.padding_top_mobile %};
    --jci-journal-hero-pad-bottom: {% render 'jci-fluid-space', max: s.padding_bottom, min: s.padding_bottom_mobile %};
    --jci-journal-hero-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-journal-hero-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --jci-journal-hero-image-ratio: {{ s.image_ratio | divided_by: 100.0 }};
    --jci-journal-hero-image-ratio-mobile: {{ s.image_ratio_mobile | divided_by: 100.0 }};
    --jci-journal-hero-image-saturate: {{ s.image_saturate | divided_by: 100.0 }};
    --jci-journal-hero-image-brightness: {{ s.image_brightness | divided_by: 100.0 }};
    --jci-journal-hero-watermark-opacity: {{ s.watermark_opacity | divided_by: 1000.0 }};
  "
>
  <div class="jci-journal-hero-container">
    <div class="jci-journal-hero-topline">
      {%- if s.topline_left != blank -%}
        <p class="jci-eyebrow jci-journal-hero-topline-eyebrow">{{ s.topline_left }}</p>
      {%- endif -%}
      {%- if s.topline_right != blank -%}
        <span class="jci-journal-hero-topline-note">{{ s.topline_right }}</span>
      {%- endif -%}
    </div>

    <div class="jci-journal-hero-main">
      <div class="jci-journal-hero-copy">
        {%- if s.eyebrow != blank -%}
          <p class="jci-eyebrow jci-journal-hero-eyebrow">{{ s.eyebrow }}</p>
        {%- endif -%}

        {%- if s.title_line_one != blank or s.title_line_two != blank -%}
          <h1 class="jci-journal-hero-title">
            {{- s.title_line_one -}}
            {%- if s.title_line_one != blank and s.title_line_two != blank -%}<br>{%- endif -%}
            {%- if s.title_line_two != blank -%}
              <em class="jci-journal-hero-title-accent">{{ s.title_line_two }}</em>
            {%- endif -%}
          </h1>
        {%- endif -%}

        {%- if s.intro != blank -%}
          <p class="jci-journal-hero-text">{{ s.intro }}</p>
        {%- endif -%}

        {%- if s.cta_label != blank -%}
          <a class="jci-text-link jci-journal-hero-cta" href="{{ s.cta_link | default: '#' }}">
            {{- s.cta_label }}
            {%- render 'jci-action-arrow', direction: 'down', class: 'jci-journal-hero-cta-arrow' -%}
          </a>
        {%- endif -%}

        {%- if meta.size > 0 -%}
          <div class="jci-journal-hero-meta">
            {%- for block in meta -%}
              <span class="jci-journal-hero-meta-item" {{ block.shopify_attributes }}>
                <strong class="jci-journal-hero-meta-index">
                  {{- block.settings.index | default: forloop.index | prepend: '0' | slice: -2, 2 -}}
                </strong>
                <small class="jci-journal-hero-meta-label">{{ block.settings.label }}</small>
              </span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        The tilt is the shared jci-tilt behaviour — it sets --jci-tilt-x / -y
        here and the CSS decides what to do with them.
      {%- endcomment -%}
      <a
        class="jci-journal-hero-feature"
        href="{{ s.feature_link | default: s.cta_link | default: '#' }}"
        {% if s.enable_tilt %}data-jci-tilt{% endif %}
        data-jci-tilt-strength="{{ s.tilt_strength }}"
      >
        {%- if feature_image != blank -%}
          <img
            class="jci-journal-hero-image"
            src="{{ feature_image | image_url: width: 1000 }}"
            srcset="
              {{ feature_image | image_url: width: 500 }} 500w,
              {{ feature_image | image_url: width: 750 }} 750w,
              {{ feature_image | image_url: width: 1000 }} 1000w
            "
            sizes="(max-width: 680px) 92vw, 52vw"
            alt="{{ feature_image.alt | escape | default: s.image_alt | escape }}"
            width="{{ feature_image.width }}"
            height="{{ feature_image.height }}"
            loading="eager"
            fetchpriority="high"
          >
        {%- elsif image_asset != blank -%}
          <img
            class="jci-journal-hero-image"
            src="{{ image_asset | asset_url }}"
            alt="{{ s.image_alt | escape }}"
            width="700"
            height="696"
            loading="eager"
            fetchpriority="high"
          >
        {%- endif -%}

        {%- if s.feature_index != blank -%}
          <span class="jci-journal-hero-feature-index">{{ s.feature_index }}</span>
        {%- endif -%}

        <div class="jci-journal-hero-feature-copy">
          {%- if s.feature_eyebrow != blank -%}
            <p class="jci-eyebrow jci-journal-hero-feature-eyebrow">{{ s.feature_eyebrow }}</p>
          {%- endif -%}
          {%- if s.feature_title != blank -%}
            <h2 class="jci-journal-hero-feature-title">{{ s.feature_title }}</h2>
          {%- endif -%}
          {%- if s.feature_link_label != blank -%}
            <span class="jci-journal-hero-feature-link">
              {{- s.feature_link_label }}
              {%- render 'jci-action-arrow', direction: 'down', class: 'jci-journal-hero-cta-arrow' -%}
            </span>
          {%- endif -%}
        </div>
      </a>
    </div>
  </div>
</section>

<script src="{{ 'jci-tilt.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* styles.css:1265 — one olive wash over ink. The contact page adds a second
     rust wash on top of this; the journal hero is the plain base. */
  .jci-journal-hero {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    color: var(--jci-journal-hero-text);
    background:
      radial-gradient(circle at 84% 12%, rgb(var(--jci-olive-rgb) / 0.2), transparent 24rem),
      var(--jci-journal-hero-bg);
  }

  /* styles.css:1266 — the oversized MC watermark. */
  .jci-journal-hero::before {
    content: 'MC';
    position: absolute;
    right: 2%;
    bottom: -14%;
    z-index: -1;
    color: rgb(var(--jci-paper-rgb) / var(--jci-journal-hero-watermark-opacity));
    font-family: var(--jci-font-display);
    font-size: clamp(190px, 31vw, 500px);
    font-weight: 600;
    pointer-events: none;
  }

  .jci-journal-hero-container {
    padding-block: var(--jci-journal-hero-pad-top) var(--jci-journal-hero-pad-bottom);
  }

  /* styles.css:1267-1269 */
  .jci-journal-hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1.2rem;
    border-bottom: 1px solid rgb(var(--jci-paper-rgb) / 0.16);
    color: var(--jci-journal-hero-meta);
  }

  .jci-journal-hero-topline-eyebrow {
    color: var(--jci-journal-hero-meta);
  }

  .jci-journal-hero-topline-note {
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  /* styles.css:1270 — the journal hero's own 560px min-height. */
  .jci-journal-hero-main {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 2vw, 2rem);
    min-height: var(--jci-journal-hero-min-height);
    padding-block-start: clamp(4rem, 8vw, 7.5rem);
  }

  /* styles.css:1271-1276, with :1064-1066 applied. */
  .jci-journal-hero-copy {
    max-width: 100%;
    align-content: center;
  }

  .jci-journal-hero-eyebrow {
    margin-block-end: 1.5rem;
    color: var(--jci-journal-hero-meta);
  }

  /* All page heroes share the hero title size (§3). */
  .jci-journal-hero-title {
    /* max-width: 590px; */
    font-family: var(--jci-font-display);
    font-size: var(--jci-hero-title-size);
    font-weight: 500;
    /* styles.css — the page heroes set their own leading. */
    line-height: 100%;
    margin: 20px 0 30px 0;
  }

  .jci-journal-hero-title-accent {
    color: var(--jci-journal-hero-accent);
    font-style: italic;
  }

  .jci-journal-hero-text {
    max-width: 340px;
    margin: 0 0 2.2rem;
    color: var(--jci-journal-hero-body);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  .jci-journal-hero-cta {
    margin-block-end: 2.2rem;
    color: var(--jci-journal-hero-text);
  }

  .jci-journal-hero-cta-arrow {
    width: 13px;
    height: 17px;
  }

  /* styles.css:1071-1102 */
  .jci-journal-hero-meta {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.7rem;
    max-width: 380px;
    padding-block-start: 1.1rem;
    border-top: 1px solid rgb(var(--jci-paper-rgb) / 0.18);
  }

  .jci-journal-hero-meta-item {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    min-width: 0;
    color: var(--jci-journal-hero-meta);
  }

  .jci-journal-hero-meta-index {
    color: var(--jci-journal-hero-text);
    font-family: var(--jci-font-label);
    font-size: 12px;
    font-weight: 400;
  }

  .jci-journal-hero-meta-label {
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  /* styles.css:1279-1284 — the journal hero's own 700px / 1.06 frame
     from :1067-1068. */
  .jci-journal-hero-feature {
    position: relative;
    display: block;
    width: min(100%, 700px);
    aspect-ratio: var(--jci-journal-hero-image-ratio);
    justify-self: end;
    overflow: hidden;
    color: var(--jci-journal-hero-text);
    background: var(--jci-journal-hero-frame);
    box-shadow:
      22px 25px 0 rgb(var(--jci-paper-rgb) / 0.06),
      0 25px 60px rgb(0 0 0 / 0.25);
    transform:
      perspective(1200px)
      rotateX(var(--jci-tilt-x, 0deg))
      rotateY(var(--jci-tilt-y, 0deg))
      translateY(var(--jci-tilt-lift, 0));
    transform-style: preserve-3d;
    transition:
      transform 0.6s var(--jci-ease),
      box-shadow 0.6s var(--jci-ease);
  }

  /* styles.css:1280 — inner rule */
  .jci-journal-hero-feature::before {
    content: '';
    position: absolute;
    inset: 13px;
    z-index: 2;
    border: 1px solid rgb(var(--jci-paper-rgb) / 0.35);
    pointer-events: none;
  }

  /* styles.css:1281 — scrim up from the base */
  .jci-journal-hero-feature::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background: linear-gradient(180deg, rgb(17 21 17 / 0.06) 35%, rgb(17 21 17 / 0.78));
    pointer-events: none;
  }

  /* styles.css:1282 with :1068's object-position. */
  .jci-journal-hero-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 52% center;
    filter:
      saturate(var(--jci-journal-hero-image-saturate))
      brightness(var(--jci-journal-hero-image-brightness));
    transition: transform 1s var(--jci-ease);
  }

  /* styles.css:1283-1284 */
  .jci-journal-hero-feature:hover,
  .jci-journal-hero-feature:focus-visible {
    --jci-tilt-lift: -6px;

    box-shadow:
      22px 30px 0 rgb(var(--jci-paper-rgb) / 0.06),
      0 32px 65px rgb(0 0 0 / 0.3);
  }

  .jci-journal-hero-feature:hover .jci-journal-hero-image,
  .jci-journal-hero-feature:focus-visible .jci-journal-hero-image {
    transform: scale(1.045);
  }

  /* styles.css:1285-1290, with :1069's narrower title. */
  .jci-journal-hero-feature-index {
    position: absolute;
    top: 1.4rem;
    right: 1.4rem;
    z-index: 3;
    color: var(--jci-journal-hero-meta);
    font-family: var(--jci-font-label);
    font-size: 12px;
  }

  .jci-journal-hero-feature-copy {
    position: absolute;
    right: 1.5rem;
    bottom: 1.5rem;
    left: 1.5rem;
    z-index: 3;
  }

  .jci-journal-hero-feature-eyebrow {
    margin-block-end: 0.7rem;
    color: var(--jci-journal-hero-accent);
  }

  .jci-journal-hero-feature-title {
    max-width: 380px;
    margin: 0 0 1.2rem;
    font-family: var(--jci-font-display);
    font-size: clamp(26px, 3.2vw, 44px);
    font-weight: 500;
  }

  .jci-journal-hero-feature-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding-block-end: 0.35rem;
    border-bottom: 1px solid rgb(var(--jci-paper-rgb) / 0.6);
    color: var(--jci-journal-hero-text);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  .jci-journal-hero-feature-arrow {
    width: 13px;
    height: 13px;
    transition: transform 0.3s var(--jci-ease);
  }

  /* styles.css:1291 */
  .jci-journal-hero-feature:hover .jci-journal-hero-feature-arrow,
  .jci-journal-hero-feature:focus-visible .jci-journal-hero-feature-arrow {
    transform: translate(3px, -3px);
  }

  /* styles.css:1239 */
  .jci-journal-hero-feature:focus-visible {
    outline: 2px solid var(--jci-rust);
    outline-offset: 4px;
  }

  /* styles.css:@900 — the two columns stack. */
  @media screen and (max-width: 900px) {
    .jci-journal-hero-main {
      grid-template-columns: 1fr;
      gap: 2.8rem;
      min-height: auto;
    }

    .jci-journal-hero-feature {
      width: min(100%, 720px);
      /* The columns have stacked, so the frame centres under the copy
         rather than hanging off the right edge. */
      justify-self: center;
    }
  }

  /* styles.css:@680 */
  @media screen and (max-width: 680px) {
    .jci-journal-hero-container {
      padding-block: var(--jci-journal-hero-pad-top-mobile) var(--jci-journal-hero-pad-bottom-mobile);
    }

    .jci-journal-hero-topline {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.6rem;
    }

    .jci-journal-hero-main {
      min-height: auto;
      padding-block-start: 3.5rem;
    }

    .jci-journal-hero-cta {
      margin-block-end: 2rem;
    }

    .jci-journal-hero-meta {
      max-width: none;
    }

    .jci-journal-hero-feature {
      width: calc(100% - 0.75rem);
      margin-inline-start: auto;
      aspect-ratio: var(--jci-journal-hero-image-ratio-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-journal-hero-feature,
    .jci-journal-hero-image,
    .jci-journal-hero-feature-arrow {
      transition: none;
    }

    .jci-journal-hero-feature:hover .jci-journal-hero-image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Journal hero",
  "tag": "section",
  "class": "jci-journal-hero-section",
  "max_blocks": 4,
  "blocks": [
    {
      "type": "meta",
      "name": "Meta item",
      "settings": [
        { "type": "text", "id": "index", "label": "Number", "info": "Leave empty to number automatically." },
        { "type": "text", "id": "label", "label": "Label", "default": "Ask about a piece" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Top rule" },
    { "type": "text", "id": "topline_left", "label": "Top left", "default": "Maison Cavallé · 2026" },
    { "type": "text", "id": "topline_right", "label": "Top right", "default": "Open line / 2026" },

    { "type": "header", "content": "Copy" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A note to the Maison" },
    { "type": "text", "id": "title_line_one", "label": "Title first line", "default": "Here when" },
    { "type": "text", "id": "title_line_two", "label": "Title second line (italic)", "default": "you need us." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Questions about a piece, your order or life around the stable? Send us a note and we’ll take care of the rest." },
    { "type": "text", "id": "cta_label", "label": "Link label", "default": "Start a conversation" },
    { "type": "url", "id": "cta_link", "label": "Link" },

    { "type": "header", "content": "Feature" },
    { "type": "text", "id": "image_asset", "label": "Image file in theme assets", "info": "A file in assets/. Used only when no image is chosen." },
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Miriam Claire with Misha the horse" },
    { "type": "url", "id": "feature_link", "label": "Link", "info": "Falls back to the copy link above." },
    { "type": "text", "id": "feature_index", "label": "Corner index", "default": "01 / 01" },
    { "type": "text", "id": "feature_eyebrow", "label": "Eyebrow", "default": "The Maison open line" },
    { "type": "text", "id": "feature_title", "label": "Title", "default": "Thoughtful answers, from our house to yours." },
    { "type": "text", "id": "feature_link_label", "label": "Link label", "default": "Write to us" },

    { "type": "header", "content": "Media treatment" },
    { "type": "range", "id": "image_ratio", "label": "Image ratio", "min": 60, "max": 140, "step": 2, "unit": "%", "default": 106, "info": "Width over height — 106 is the prototype's 1.06." },
    { "type": "range", "id": "image_ratio_mobile", "label": "Image ratio on mobile", "min": 60, "max": 140, "step": 2, "unit": "%", "default": 88 },
    { "type": "range", "id": "image_saturate", "label": "Saturation", "min": 0, "max": 180, "step": 2, "unit": "%", "default": 72 },
    { "type": "range", "id": "image_brightness", "label": "Brightness", "min": 20, "max": 150, "step": 2, "unit": "%", "default": 80 },
    { "type": "range", "id": "watermark_opacity", "label": "Watermark strength", "min": 0, "max": 120, "step": 5, "unit": "%", "default": 35, "info": "Thousandths — 35 is the prototype's 0.035." },

    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "enable_tilt", "label": "Tilt the feature towards the pointer", "default": true },
    { "type": "range", "id": "tilt_strength", "label": "Tilt strength", "min": 0, "max": 20, "step": 1, "unit": "deg", "default": 6 },

    { "type": "header", "content": "Colors", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "accent_color", "label": "Accent" },
    { "type": "color", "id": "body_color", "label": "Body text" },
    { "type": "color", "id": "meta_color", "label": "Metadata" },
    { "type": "color", "id": "frame_background", "label": "Image frame" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "min_height", "label": "Minimum height", "min": 300, "max": 900, "step": 10, "unit": "px", "default": 560 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 76 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Anchor" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "journal-hero" }
  ],
  "presets": [
    {
      "name": "Journal hero",
      "blocks": [
        { "type": "meta", "settings": { "index": "01", "label": "Ask about a piece" } },
        { "type": "meta", "settings": { "index": "02", "label": "Track an order" } },
        { "type": "meta", "settings": { "index": "03", "label": "Find your fit" } }
      ]
    }
  ]
}
{% endschema %}
