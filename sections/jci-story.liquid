{% comment %}
  Maison Cavallé — story
  Prototype source: maison-cavalle-main/app.js → renderHome, .story-section markup
                    maison-cavalle-main/styles.css → .story-* (lines 188–226, 1437, 1526–1533)
                    maison-cavalle-main/app.js → activateMotion (reveal + data-tilt)
  Reference: MAISON-CAVALLE-SPEC.md §1

  Copy on the left, a framed film on the right that leans towards the pointer.
  Every string is a setting so the whole section is editable from the Theme
  Editor.

  The film resolves in the order the hero uses: a Shopify Files upload wins,
  then an assets/ filename, then the poster alone. Both paths are supported so
  a clip can live wherever the store prefers.
{% endcomment %}

{% liquid
  assign s = section.settings

  assign poster_src = blank
  if s.poster_asset != blank
    assign poster_src = s.poster_asset | strip | asset_url
  elsif s.poster != blank
    assign poster_src = s.poster | image_url: width: 1400
  elsif s.video != blank
    assign poster_src = s.video.preview_image | image_url: width: 1400
  endif

  assign has_film = false
  if s.video_asset != blank or s.video != blank
    assign has_film = true
  endif
%}

<jci-story
  class="jci-story"
  {% if s.enable_reveal %}data-jci-story-reveal{% endif %}
  {% if s.enable_tilt %}data-jci-story-tilt-enabled{% endif %}
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="
    --jci-story-bg: {{ s.background_color | default: settings.color_palette.color3 }};
    --jci-story-bg-rgb: {{ s.background_color.rgb | default: settings.color_palette.color3.rgb }};
    --jci-story-wash-rgb: {{ s.wash_color.rgb | default: settings.color_palette.color5.rgb }};
    --jci-story-wash-opacity: {{ s.wash_opacity | divided_by: 100.0 }};
    --jci-story-heading: {{ s.heading_color | default: settings.color_palette.foreground }};
    --jci-story-heading-rgb: {{ s.heading_color.rgb | default: settings.color_palette.foreground.rgb }};
    --jci-story-accent: {{ s.accent_color | default: settings.color_palette.color5 }};
    --jci-story-accent-rgb: {{ s.accent_color.rgb | default: settings.color_palette.color5.rgb }};
    --jci-story-body: {{ s.body_color }};
    --jci-story-meta: {{ s.meta_color }};
    --jci-story-caption-meta: {{ s.caption_meta_color }};
    --jci-story-mark-opacity: {{ s.watermark_opacity | divided_by: 100.0 }};
    --jci-story-watermark: '{{ s.watermark | replace: "'", "" | escape }}';
    --jci-story-on-film: {{ s.on_film_color | default: settings.color_palette.background }};
    --jci-story-on-film-rgb: {{ s.on_film_color.rgb | default: settings.color_palette.background.rgb }};
    --jci-story-scrim-rgb: {{ s.scrim_color.rgb }};
    --jci-story-glow-rgb: {{ s.glow_color.rgb }};
    --jci-story-rule: {{ s.rule_color | default: settings.color_palette.color6 }};
    --jci-story-rule-rgb: {{ s.rule_color.rgb | default: settings.color_palette.color6.rgb }};
    --jci-story-media-gap: clamp(2.5rem, 7vw, {{ s.column_gap | divided_by: 10.0 }}rem);
    {%- if s.background_width == 'full' %}
      --jci-container-width: 100vw;
      --jci-container-offset: calc(50% - 50vw);
    {%- endif %}
    --jci-story-copy-max: {{ s.copy_max_width }}px;
    --jci-story-frame-min: {{ s.frame_min_height }}px;
    --jci-story-film-saturate: {{ s.film_saturate | divided_by: 100.0 }};
    --jci-story-film-contrast: {{ s.film_contrast | divided_by: 100.0 }};
    --jci-story-pad-top: {% render 'jci-fluid-space', max: s.padding_top, min: s.padding_top_mobile %};
    --jci-story-pad-bottom: {% render 'jci-fluid-space', max: s.padding_bottom, min: s.padding_bottom_mobile %};
    --jci-story-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-story-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="jci-story-container">
    <div class="jci-story-copy">
      {%- if s.kicker != blank -%}
        <span class="jci-story-kicker">
          <span class="jci-story-kicker-dot" aria-hidden="true"></span>
          {{ s.kicker }}
        </span>
      {%- endif -%}

      {%- if s.title_line_one != blank or s.title_line_two != blank -%}
        <h2 class="jci-story-title">
          {{- s.title_line_one -}}
          {%- if s.title_line_one != blank and s.title_line_two != blank -%}<br>{%- endif -%}
          {%- if s.title_line_two != blank -%}
            <em class="jci-story-title-accent">{{ s.title_line_two }}</em>
          {%- endif -%}
        </h2>
      {%- endif -%}

      <div class="jci-story-brand-copy">
        {%- comment -%}
          Three separate settings rather than one rich text field: rich text
          emits its own <p>, which would have to be reached by a descendant
          selector. §1 allows neither.
        {%- endcomment -%}
        {%- for i in (1..3) -%}
          {%- case i -%}
            {%- when 1 -%}{%- assign paragraph = s.paragraph_one -%}
            {%- when 2 -%}{%- assign paragraph = s.paragraph_two -%}
            {%- when 3 -%}{%- assign paragraph = s.paragraph_three -%}
          {%- endcase -%}
          {%- if paragraph != blank -%}
            <p class="jci-story-paragraph">{{ paragraph }}</p>
          {%- endif -%}
        {%- endfor -%}

        {%- if s.belief_one != blank or s.belief_two != blank -%}
          <div class="jci-story-belief">
            {%- if s.belief_one != blank -%}
              <p class="jci-story-belief-line">{{ s.belief_one }}</p>
            {%- endif -%}
            {%- if s.belief_two != blank -%}
              <p class="jci-story-belief-line jci-story-belief-line--accent">{{ s.belief_two }}</p>
            {%- endif -%}
          </div>
        {%- endif -%}

        {%- if s.signoff_name != blank or s.signoff_tagline != blank -%}
          <div class="jci-story-signoff">
            {%- if s.signoff_name != blank -%}
              <span class="jci-story-signoff-name">{{ s.signoff_name }}</span>
            {%- endif -%}
            {%- if s.signoff_tagline != blank -%}
              <strong class="jci-story-signoff-tagline">{{ s.signoff_tagline }}</strong>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if s.link_label != blank or s.scroll_note != blank -%}
        <div class="jci-story-actions">
          {%- if s.link_label != blank -%}
            <a class="jci-text-link jci-story-link" href="{{ s.link_url | default: routes.root_url }}">
              {{ s.link_label }} {% render 'jci-action-arrow' %}
            </a>
          {%- endif -%}
          {%- if s.scroll_note != blank -%}
            <span class="jci-story-scroll-note">
              {{ s.scroll_note }} <span class="jci-story-scroll-note-icon" aria-hidden="true">{% render 'jci-action-arrow', direction: 'down', class: 'jci-story-scroll-note-arrow' %}</span>
            </span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="jci-story-visual">
      <div class="jci-story-frame" data-jci-story-tilt>
        <span class="jci-story-glow" aria-hidden="true"></span>

        {%- if has_film -%}
          <video
            class="jci-story-film"
            autoplay
            muted
            loop
            playsinline
            preload="metadata"
            {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
            aria-label="{{ s.film_label }}"
          >
            {%- comment -%}
              A Files upload wins so the clip can exceed the 20 MB asset cap.
              An assets/ filename is the fallback, so the clip can travel with
              the theme code instead.
            {%- endcomment -%}
            {%- if s.video != blank -%}
              {%- for source in s.video.sources -%}
                {%- if source.format == 'mp4' -%}
                  <source src="{{ source.url }}" type="{{ source.mime_type }}">
                {%- endif -%}
              {%- endfor -%}
            {%- else -%}
              <source src="{{ s.video_asset | strip | asset_url }}" type="video/mp4">
            {%- endif -%}
          </video>
        {%- elsif poster_src != blank -%}
          {%- comment -%} No film yet — the still keeps the layout judgeable. {%- endcomment -%}
          <img
            class="jci-story-film"
            src="{{ poster_src }}"
            alt="{{ s.film_label }}"
            width="{{ s.poster.width | default: 1400 }}"
            height="{{ s.poster.height | default: 1489 }}"
            loading="lazy"
          >
        {%- endif -%}

        <span class="jci-story-overlay" aria-hidden="true"></span>

        {%- if s.topline_left != blank or s.topline_right != blank -%}
          <div class="jci-story-topline">
            <span class="jci-story-topline-name">{{ s.topline_left }}</span>
            <span class="jci-story-topline-index">{{ s.topline_right }}</span>
          </div>
        {%- endif -%}

        {%- if s.mark != blank -%}
          <span class="jci-story-mark" aria-hidden="true">{{ s.mark }}</span>
        {%- endif -%}

        {%- if s.caption_label != blank or s.caption_title != blank -%}
          <div class="jci-story-caption">
            {%- if s.caption_label != blank -%}
              <span class="jci-story-caption-label">{{ s.caption_label }}</span>
            {%- endif -%}
            {%- if s.caption_title != blank -%}
              <strong class="jci-story-caption-title">{{ s.caption_title }}</strong>
            {%- endif -%}
          </div>
        {%- endif -%}
      </div>

      {%- if s.stat_value != blank -%}
        <div class="jci-story-float-note">
          <strong class="jci-story-float-note-value">
            {{- s.stat_value -}}
            {%- if s.stat_suffix != blank -%}
              <span class="jci-story-float-note-suffix">{{ s.stat_suffix }}</span>
            {%- endif -%}
          </strong>
          {%- if s.stat_label != blank -%}
            <small class="jci-story-float-note-label">{{ s.stat_label }}</small>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</jci-story>

<script src="{{ 'jci-story.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .jci-story {
    display: block;
    /* styles.css `.story-section` — without this the oversized "MC" watermark
       on .jci-story-container::before escapes and widens the document. */
    overflow: hidden;
    opacity: 1;
  }

  /* Reveal opts in from the section settings; without it the section is
     painted normally so a no-JS visitor still sees the copy. */
  .jci-story[data-jci-story-reveal] {
    opacity: 0;
    transform: translateY(22px);
    transition:
      opacity 0.75s var(--jci-ease),
      transform 0.75s var(--jci-ease);
  }

  .jci-story[data-jci-story-reveal].is-revealed {
    opacity: 1;
    transform: none;
  }

  /* The prototype carries padding, background and grid on one element
     (.story-section = .section + grid), so the cream covers the vertical
     padding too. Splitting them would leave a page-coloured band above and
     below the section. */
  .jci-story-container {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 0.88fr) minmax(0, 1.12fr);
    gap: var(--jci-story-media-gap);
    align-items: center;
    overflow: hidden;
    padding-block: var(--jci-story-pad-top) var(--jci-story-pad-bottom);
    background:
      radial-gradient(
        circle at 92% 10%,
        rgb(var(--jci-story-wash-rgb) / var(--jci-story-wash-opacity)),
        transparent 25rem
      ),
      var(--jci-story-bg);
  }

  /* Oversized MC watermark, ghosted into the top-right corner. */
  .jci-story-container::before {
    content: var(--jci-story-watermark, "MC");
    position: absolute;
    top: 8%;
    right: 5%;
    color: rgb(var(--jci-story-heading-rgb) / var(--jci-story-mark-opacity));
    font-family: var(--jci-font-display);
    font-size: clamp(120px, 20vw, 290px);
    font-weight: 600;
    pointer-events: none;
  }

  /* -- Copy column ------------------------------------------------------- */

  .jci-story-copy {
    position: relative;
    z-index: 1;
    align-self: start;
    max-width: var(--jci-story-copy-max);
    padding-top: clamp(0.5rem, 2vw, 2rem);
  }

  .jci-story-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    margin-bottom: 1.7rem;
    color: var(--jci-story-accent);
    font-family: var(--jci-font-label);
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
  }

  .jci-story-kicker-dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--jci-story-rule);
    box-shadow: 0 0 0 5px rgb(var(--jci-story-rule-rgb) / 0.12);
  }

  .jci-story-title {
    max-width: 570px;
    margin: 0 0 1.5rem;
    color: var(--jci-story-heading);
    font-family: var(--jci-font-display);
    font-size: var(--jci-section-title-size);
    font-weight: 500;
  }

  .jci-story-title-accent {
    color: var(--jci-story-accent);
    font-style: italic;
  }

  .jci-story-paragraph {
    max-width: 530px;
    margin: 0 0 1rem;
    color: var(--jci-story-body);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  .jci-story-belief {
    margin: 2rem 0;
    padding: 1.3rem 0 1.3rem 1.2rem;
    border-left: 1px solid var(--jci-story-rule);
  }

  .jci-story-belief-line {
    max-width: 520px;
    margin: 0;
    color: var(--jci-story-heading);
    font-family: var(--jci-font-display);
    font-size: clamp(1.2rem, 1.7vw, 1.65rem);
    font-weight: 500;
  }

  .jci-story-belief-line--accent {
    margin-top: 0.65rem;
    color: var(--jci-story-accent);
  }

  .jci-story-signoff {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    margin-top: 1.8rem;
    padding-top: 1rem;
    border-top: 1px solid var(--jci-line);
    color: var(--jci-story-accent);
  }

  .jci-story-signoff-name {
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  /* styles.css:1248 — Playfair, not the sans the container sets. */
  .jci-story-signoff-tagline {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--jci-story-heading);
    font-family: var(--jci-font-display);
    font-size: 18px;
    font-weight: 500;
    text-transform: none;
  }

  .jci-story-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    margin-top: 2rem;
  }

 .jci-story-scroll-note {
     display: none; /*inline-flex */
    align-items: center;
    gap: .55rem;
    color: var(--jci-story-meta);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
}

  /* The arrow sits inside the bobbing circle, so it keeps its own size. */
  .jci-story-scroll-note-arrow {
    flex: 0 0 10px;
    width: 10px;
    height: 10px;
  }

  .jci-story-scroll-note-icon {
    display: grid;
    place-items: center;
    width: 27px;
    height: 27px;
    border: 1px solid var(--jci-line);
    border-radius: 50%;
    animation: jci-story-bob 1.8s ease-in-out infinite;
  }

  @keyframes jci-story-bob {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(4px);
    }
  }

  /* -- Film column ------------------------------------------------------- */

  .jci-story-visual {
    position: relative;
    aspect-ratio: 0.94;
    overflow: visible;
    perspective: 1200px;
  }

  .jci-story-frame {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: var(--jci-story-frame-min);
    overflow: hidden;
    box-shadow:
      20px 24px 0 rgb(var(--jci-story-heading-rgb) / 0.08),
      0 24px 60px rgb(var(--jci-story-heading-rgb) / 0.13);
    transform: rotateX(var(--jci-story-tilt-x, 0deg)) rotateY(var(--jci-story-tilt-y, 0deg));
    transform-style: preserve-3d;
    transition:
      transform 0.6s var(--jci-ease),
      box-shadow 0.6s var(--jci-ease);
    will-change: transform;
  }

  /* Inset hairline, floated above the film. */
  .jci-story-frame::before {
    content: "";
    position: absolute;
    z-index: 2;
    inset: 12px;
    border: 1px solid rgb(var(--jci-story-on-film-rgb) / 0.38);
    pointer-events: none;
  }

  .jci-story-glow {
    position: absolute;
    z-index: 1;
    inset: -20%;
    background: radial-gradient(
      circle at 70% 35%,
      rgb(var(--jci-story-glow-rgb) / 0.2),
      transparent 45%
    );
    mix-blend-mode: screen;
    pointer-events: none;
  }

  .jci-story-film {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    filter: saturate(var(--jci-story-film-saturate)) contrast(var(--jci-story-film-contrast));
    transition: transform 1.2s var(--jci-ease);
  }

  .jci-story.is-revealed .jci-story-film {
    transform: scale(1.04);
  }

  .jci-story-overlay {
    position: absolute;
    z-index: 2;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgb(var(--jci-story-scrim-rgb) / 0.08),
      transparent 48%,
      rgb(var(--jci-story-scrim-rgb) / 0.58)
    );
    pointer-events: none;
  }

  .jci-story-topline {
    position: absolute;
    z-index: 3;
    top: 1.3rem;
    right: 1.3rem;
    left: 1.3rem;
    display: flex;
    justify-content: space-between;
    color: rgb(var(--jci-story-on-film-rgb) / 0.82);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  .jci-story-mark {
    position: absolute;
    z-index: 3;
    right: 1.3rem;
    bottom: 1.2rem;
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border: 1px solid rgb(var(--jci-story-on-film-rgb) / 0.75);
    border-radius: 50%;
    color: var(--jci-story-on-film);
    font-family: var(--jci-font-label);
    font-size: 14px;
  }

  .jci-story-caption {
    position: absolute;
    z-index: 3;
    bottom: 1.2rem;
    left: 1.3rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    color: var(--jci-story-on-film);
  }

  .jci-story-caption-label {
    color: var(--jci-story-caption-meta);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  .jci-story-caption-title {
    max-width: 220px;
    font-family: var(--jci-font-display);
    font-size: 23px;
    font-weight: 500;
  }

  .jci-story-float-note {
    position: absolute;
    z-index: 4;
    right: -1.8rem;
    bottom: 10%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 104px;
    height: 104px;
    border: 1px solid rgb(var(--jci-story-heading-rgb) / 0.24);
    border-radius: 50%;
    color: var(--jci-story-heading);
    background: var(--jci-story-on-film);
    box-shadow: 0 14px 30px rgb(var(--jci-story-heading-rgb) / 0.12);
    transform: translateZ(60px) rotate(8deg);
  }

  .jci-story-float-note-value {
    font-family: var(--jci-font-display);
    font-size: 31px;
    font-weight: 500;
  }

  .jci-story-float-note-suffix {
    color: var(--jci-story-rule);
    font-size: 18px;
  }

.jci-story-float-note-label {
    /* max-width: 65px; */
    /* margin-top: .4rem; */
    color: var(--jci-story-meta);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-align: center;
    text-transform: uppercase;
}

  /* -- Breakpoints (§5 — 900 and 680 only) ------------------------------- */

  @media screen and (max-width: 900px) {
    .jci-story-container {
      gap: 3rem;
    }
  }

  @media screen and (max-width: 680px) {
    .jci-story-container {
      padding-block: var(--jci-story-pad-top-mobile) var(--jci-story-pad-bottom-mobile);
      display: flex;
      flex-direction: column;
      gap: 3.5rem;
      align-items: stretch;
    }

    .jci-story-copy {
      max-width: none;
      padding-top: 0;
    }

    .jci-story-actions {
      gap: 1.2rem;
    }

    .jci-story-visual {
      width: calc(100% - 1rem);
      align-self: flex-end;
    }

    .jci-story-frame {
      min-height: 440px;
    }

    .jci-story-float-note {
      right: -0.5rem;
      bottom: 40%;
      width: 92px;
      height: 92px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-story,
    .jci-story-film,
    .jci-story-frame,
    .jci-story-scroll-note-icon {
      animation: none;
    }

    .jci-story.is-revealed .jci-story-film {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Story",
  "tag": "section",
  "class": "jci-story-section",
  "settings": [
    { "type": "header", "content": "Kicker" },
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "A life shaped by horses" },

    { "type": "header", "content": "Heading" },
    { "type": "text", "id": "title_line_one", "label": "First line", "default": "Born from a life" },
    { "type": "text", "id": "title_line_two", "label": "Second line (italic)", "default": "with horses." },

    { "type": "header", "content": "Body copy" },
    { "type": "textarea", "id": "paragraph_one", "label": "Paragraph 1", "default": "Maison Cavallé is a boutique equestrian label shaped by more than fifty years spent around horses." },
    { "type": "textarea", "id": "paragraph_two", "label": "Paragraph 2", "default": "For us, equestrian style has never simply been about what you wear in the saddle. It is a way of life, one built on tradition, quiet confidence and an appreciation for things made well." },
