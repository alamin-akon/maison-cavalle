        { "type": "quote", "settings": { "label": "From the stable", "tone": "soft", "quote": "The Groomi is now part of our everyday ritual — easy to hold, easy to use and a little brighter in the wash bay.", "name": "Hannah L.", "attribution": "The Groomi Horse Shedder" } },
        { "type": "quote", "settings": { "label": "Customer note", "tone": "default", "quote": "The breeches move with me without losing their shape. Thoughtful details, a beautiful weight and no fuss in the saddle.", "name": "Sophie M.", "attribution": "Pro-Skin Performance Tights" } },
        { "type": "quote", "settings": { "label": "Maison community", "tone": "soft", "quote": "Beautifully made and genuinely easy to wear. The kind of layer that works from an early lesson to coffee afterwards.", "name": "Olivia T.", "attribution": "Active Turtleneck Top" } },
        { "type": "quote", "settings": { "label": "From the stable", "tone": "default", "quote": "The grooming kit feels like a small daily luxury. Everything has its place, and the brushes are lovely to use.", "name": "Claire B.", "attribution": "Deluxe Grooming Kit" } }
      ]
