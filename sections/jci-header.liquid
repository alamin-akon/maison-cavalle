{% comment %}
  Maison Cavallé — header
  Prototype source: maison-cavalle-main/index.html → .site-header
                    maison-cavalle-main/styles.css → .site-header, .header-inner,
                    .desktop-nav, .icon-button, .header-wordmark, .mobile-menu
  Reference: MAISON-CAVALLE-SPEC.md §1

  Layout and styling are the prototype's. Behaviour reuses Horizon's own
  globally rendered components rather than reimplementing them:
    - cart drawer  → on:click="#cart-drawer/toggle"   (layout/theme.liquid)
    - search modal → on:click="#search-modal/showDialog" (layout/theme.liquid)
  Only the mobile navigation drawer is ours, because the prototype's drawer is
  a distinct design.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign menu = linklists[s.menu]

  assign logo_alt = 'accessibility.home_logo_alt' | t: store_name: shop.name

  assign height_scrolled = s.height_scrolled
  assign logo_height_scrolled = s.logo_height_scrolled
  unless s.shrink_on_scroll
    assign height_scrolled = s.height
    assign logo_height_scrolled = s.logo_height
  endunless
%}

<jci-header
  class="jci-header"
  {% if s.enable_sticky %}
    data-jci-sticky
  {% endif %}
  {% if s.hide_labels_tablet %}
    data-jci-hide-labels-tablet
  {% endif %}
  {% if s.hide_account_mobile %}
    data-jci-hide-account-mobile
  {% endif %}
  style="
    --jci-header-bg: {{ s.background_color | default: settings.color_palette.background }};
    --jci-header-bg-rgb: {{ s.background_color.rgb | default: settings.color_palette.background.rgb }};
    --jci-header-text: {{ s.text_color | default: settings.color_palette.foreground }};
    --jci-header-blur: {{ s.backdrop_blur }}px;
    --jci-header-saturate: {{ s.backdrop_saturate | divided_by: 100.0 }};
    --jci-header-bg-opacity-top: {{ s.bg_opacity_top | divided_by: 100.0 }};
    --jci-header-bg-opacity-bottom: {{ s.bg_opacity_bottom | divided_by: 100.0 }};
    --jci-header-bg-opacity-scrolled: {{ s.bg_opacity_scrolled | divided_by: 100.0 }};
    --jci-header-border-opacity: {{ s.border_opacity | divided_by: 100.0 }};
    --jci-header-height: {{ s.height }}px;
    --jci-header-height-mobile: {{ s.height_mobile }}px;
    --jci-header-height-scrolled: {{ height_scrolled }}px;
    --jci-header-logo-width: {{ s.logo_width }}px;
    --jci-header-logo-height: {{ s.logo_height }}px;
    --jci-header-logo-height-scrolled: {{ logo_height_scrolled }}px;
    --jci-header-logo-width-mobile: {{ s.logo_width_mobile }}px;
    --jci-header-logo-height-mobile: {{ s.logo_height_mobile }}px;
    --jci-header-nav-size: {{ s.nav_font_size }}px;
    --jci-header-nav-gap: {{ s.nav_gap }}px;
    --jci-header-nav-hover: {{ s.nav_hover_color | default: settings.color_palette.color5 }};
    --jci-header-nav-dot: {{ s.nav_dot_color | default: settings.color_palette.color6 }};
    --jci-header-nav-dot-rgb: {{ s.nav_dot_color.rgb | default: settings.color_palette.color6.rgb }};
    --jci-header-label-size: {{ s.label_size }}px;
    --jci-header-icon-size: {{ s.icon_size }}px;
    --jci-header-icon-stroke: {{ s.icon_stroke_width | divided_by: 100.0 }};
    --jci-header-badge-size: {{ s.cart_badge_size }}px;
    --jci-header-badge-bg: {{ s.cart_badge_color | default: settings.color_palette.foreground }};
    --jci-header-badge-hover-bg: {{ s.cart_badge_hover_color | default: settings.color_palette.color6 }};
    --jci-header-drawer-bg: {{ s.drawer_background_color | default: settings.color_palette.color3 }};
    --jci-header-drawer-width: {{ s.drawer_width }}px;
    {% unless s.enable_reveal %}--jci-header-reveal-name: none; --jci-header-logo-reveal-name: none;{% endunless %}
    {% unless s.enable_glint %}--jci-header-glint-name: none;{% endunless %}
  "
>
  <div class="jci-header-container">
    {%- comment -%} Mobile only — opens the navigation drawer. {%- endcomment -%}
    <button
      class="jci-header-icon-button jci-header-menu-trigger"
      type="button"
      data-jci-menu-trigger
      aria-expanded="false"
      aria-controls="jci-header-drawer"
    >
      <span class="jci-header-menu-icon" aria-hidden="true"><i></i><i></i></span>
      <span class="jci-header-menu-label">{{ 'accessibility.menu' | t }}</span>
    </button>

    {%- if menu != blank and menu.links.size > 0 -%}
      <nav class="jci-header-nav" aria-label="{{ 'accessibility.menu' | t | default: shop.name }}">
        {%- for link in menu.links -%}
          <a
            class="jci-header-nav-link{% if link.active %} is-active{% endif %}"
            href="{{ link.url }}"
          >
            {{- link.title -}}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    <a class="jci-header-wordmark" href="{{ routes.root_url }}">
      {%- if settings.logo != blank -%}
        {{
          settings.logo
          | image_url: width: 620
          | image_tag: class: 'jci-header-logo', alt: logo_alt, loading: 'eager', fetchpriority: 'high'
        }}
      {%- else -%}
        {%- comment -%}
          No logo uploaded: fall back to the wordmark shipped in the theme's own
          assets, so the logo travels with the theme code. See SPEC §2.
        {%- endcomment -%}
        <img
          class="jci-header-logo"
          src="{{ 'jci-logo.svg' | asset_url }}"
          alt="{{ logo_alt }}"
          width="620"
          height="354"
          loading="eager"
          fetchpriority="high"
        >
      {%- endif -%}
    </a>

    <div class="jci-header-actions">
      {%- if s.show_search -%}
        <button
          class="jci-header-icon-button jci-header-search-trigger"
          type="button"
          on:click="#search-modal/showDialog"
          aria-haspopup="dialog"
          aria-label="{{ 'content.search_input_label' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="10.8" cy="10.8" r="6.2"></circle>
            <path d="m16 16 4.2 4.2"></path>
          </svg>
          <span class="jci-header-action-label">{{ 'content.search' | t }}</span>
        </button>
      {%- endif -%}

      {%- if s.show_account and shop.customer_accounts_enabled -%}
        <a
          class="jci-header-icon-button jci-header-account-trigger"
          href="{{ routes.account_url }}"
          aria-label="{{ 'content.account_title' | t }}"
        >
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <circle cx="12" cy="8" r="3.2"></circle>
            <path d="M5.8 20c.7-3.3 2.7-5 6.2-5s5.5 1.7 6.2 5"></path>
          </svg>
          <span class="jci-header-action-label">{{ 'content.account_title' | t }}</span>
        </a>
      {%- endif -%}

      {%- if s.show_cart -%}
        {%- capture cart_inner -%}
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5.4 8.5h13.2l1 11H4.4l1-11Z"></path>
            <path d="M8.5 9V6.8a3.5 3.5 0 0 1 7 0V9"></path>
          </svg>
          <span class="jci-header-action-label">{{ 'content.cart_title' | t }}</span>
          <span class="jci-header-cart-count">{{ cart.item_count }}</span>
        {%- endcapture -%}

        {%- if settings.cart_type == 'drawer' and template.name != 'cart' -%}
          <button
            class="jci-header-icon-button jci-header-cart-trigger"
            type="button"
            on:click="#cart-drawer/toggle"
            aria-haspopup="dialog"
            aria-expanded="false"
            aria-controls="cart-drawer"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            {{ cart_inner }}
          </button>
        {%- else -%}
          <a
            class="jci-header-icon-button jci-header-cart-trigger"
            href="{{ routes.cart_url }}"
            aria-label="{{ 'accessibility.cart' | t }}"
          >
            {{ cart_inner }}
          </a>
        {%- endif -%}
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Mobile navigation drawer — the prototype's own design. {%- endcomment -%}
  <div class="jci-header-backdrop" data-jci-drawer-backdrop hidden></div>

  <aside
    class="jci-header-drawer"
    id="jci-header-drawer"
    data-jci-drawer
    aria-label="{{ 'accessibility.menu' | t | default: shop.name }}"
    aria-hidden="true"
    inert
  >
    <div class="jci-header-drawer-head">
      <button class="jci-header-drawer-back" type="button" data-jci-drawer-close>
        {%- render 'jci-action-arrow', direction: 'left', class: 'jci-header-drawer-back-icon' -%}
        {{ 'actions.close' | t }}
      </button>
      <span class="jci-eyebrow">{{ shop.name }}</span>
    </div>

    {%- if s.drawer_eyebrow != blank -%}
      <div class="jci-header-drawer-intro">
        <span class="jci-eyebrow">{{ s.drawer_eyebrow }}</span>
        {%- if menu != blank -%}
          <span>{{ menu.links.size }} {{ s.drawer_count_label }}</span>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if menu != blank and menu.links.size > 0 -%}
      <nav class="jci-header-drawer-nav">
        {%- for link in menu.links -%}
          <a class="jci-header-drawer-link" href="{{ link.url }}">
            {{ link.title }} {% render 'jci-action-arrow', class: 'jci-header-drawer-arrow' %}
          </a>
        {%- endfor -%}
      </nav>
    {%- endif -%}

    {%- if s.drawer_footer_left != blank or s.drawer_footer_right != blank -%}
      <div class="jci-header-drawer-footer">
        <span>{{ s.drawer_footer_left }}</span>
        <span>{{ s.drawer_footer_right }}</span>
      </div>
    {%- endif -%}
  </aside>
</jci-header>

<script src="{{ 'jci-header.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .jci-header {
    position: relative;
    z-index: 10;
    display: block;
    isolation: isolate;
    color: var(--jci-header-text);
    background: linear-gradient(
      180deg,
      rgb(var(--jci-header-bg-rgb) / var(--jci-header-bg-opacity-top)),
      rgb(var(--jci-header-bg-rgb) / var(--jci-header-bg-opacity-bottom))
    );
    border-block-end: 1px solid rgb(var(--color-foreground-rgb) / var(--jci-header-border-opacity));
    box-shadow: 0 8px 24px rgb(var(--color-foreground-rgb) / 0.04);
    backdrop-filter: blur(var(--jci-header-blur)) saturate(var(--jci-header-saturate));
    -webkit-backdrop-filter: blur(var(--jci-header-blur)) saturate(var(--jci-header-saturate));
    animation: var(--jci-header-reveal-name, jci-header-reveal) 0.8s var(--jci-ease) both;
    transition: background 0.35s var(--jci-ease), border-color 0.35s var(--jci-ease),
      box-shadow 0.35s var(--jci-ease);
  }

.jci-header[data-jci-sticky] {
    position: sticky;
    top: 0;
    overflow: hidden;
}

  .jci-header.is-scrolled {
    background: rgb(var(--jci-header-bg-rgb) / var(--jci-header-bg-opacity-scrolled));
    box-shadow: 0 10px 28px rgb(var(--color-foreground-rgb) / 0.08);
  }

  /* One-off light sweep across the header on first paint. */
  .jci-header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 0;
    background: linear-gradient(105deg, transparent 35%, rgb(255 255 255 / 0.55) 50%, transparent 65%);
    pointer-events: none;
    transform: translateX(-120%);
    animation: var(--jci-header-glint-name, jci-header-glint) 1.4s 0.25s var(--jci-ease) both;
  }

  .jci-header-container {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
    align-items: center;
    gap: 1rem;
    min-height: var(--jci-header-height);
    padding-block: 0.75rem;
    transition: min-height 0.35s var(--jci-ease), padding 0.35s var(--jci-ease);
  }

  .jci-header.is-scrolled .jci-header-container {
    min-height: var(--jci-header-height-scrolled);
    padding-block: 0.4rem;
  }

  /* --- Desktop navigation --- */
  .jci-header-nav {
    display: flex;
    align-items: center;
    min-width: 0;
    gap: var(--jci-header-nav-gap);
  }

  .jci-header-nav-link {
    position: relative;
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 0.05rem;
    color: inherit;
    font-family: var(--jci-font-label);
    font-size: var(--jci-header-nav-size);
    text-decoration: none;
    text-transform: uppercase;
    transition: color 0.3s var(--jci-ease), transform 0.3s var(--jci-ease);
  }

  /* Dot that appears to the left of a hovered link. */
  .jci-header-nav-link::before {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: -0.65rem;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--jci-header-nav-dot);
    transform: translateY(-50%) scale(0);
    transition: transform 0.3s var(--jci-ease);
  }

  /* Underline that sweeps in from the left. */
  .jci-header-nav-link::after {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-end: 0.15rem;
    height: 1px;
    background: currentcolor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.4s var(--jci-ease);
  }

  .jci-header-nav-link:hover,
  .jci-header-nav-link:focus-visible {
    color: var(--jci-header-nav-hover);
    transform: translateY(-2px);
  }

  .jci-header-nav-link:hover::before,
  .jci-header-nav-link:focus-visible::before {
    transform: translateY(-50%) scale(1);
  }

  .jci-header-nav-link:hover::after,
  .jci-header-nav-link:focus-visible::after {
    transform: scaleX(1);
  }

  /* --- Logo --- */
  .jci-header-wordmark {
    position: relative;
    justify-self: center;
    display: flex;
    align-items: center;
    justify-content: center;
    width: min(var(--jci-header-logo-width), 24vw);
    height: var(--jci-header-logo-height);
    overflow: visible;
    animation: var(--jci-header-logo-reveal-name, jci-header-logo-reveal) 0.85s 0.08s var(--jci-ease) both;
    transition: transform 0.4s var(--jci-ease), height 0.35s var(--jci-ease);
  }

  .jci-header-wordmark:hover,
  .jci-header-wordmark:focus-visible {
    transform: translateY(-2px);
  }

  .jci-header-logo {
    display: block;
    width: 100%;
    max-width: 100%;
    height: 100%;
    object-fit: contain;
    transition: transform 0.5s var(--jci-ease);
  }

  .jci-header-wordmark:hover .jci-header-logo,
  .jci-header-wordmark:focus-visible .jci-header-logo {
    transform: scale(1.035);
  }

  .jci-header.is-scrolled .jci-header-wordmark {
    height: var(--jci-header-logo-height-scrolled);
  }

  /* --- Actions --- */
  .jci-header-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    min-width: 0;
    gap: clamp(0.75rem, 1.7vw, 1.5rem);
  }

  .jci-header-icon-button {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.48rem;
    padding: 0.4rem 0;
    color: inherit;
    border: 0;
    background: transparent;
    text-decoration: none;
    cursor: pointer;
    transition: color 0.3s var(--jci-ease), transform 0.35s var(--jci-ease);
  }

  /* Pill that fades in behind a hovered action. */
  .jci-header-icon-button::before {
    content: '';
    position: absolute;
    inset: 0.1rem -0.35rem;
    z-index: 0;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgb(var(--jci-olive-rgb) / 0);
    pointer-events: none;
    transform: scale(0.85);
    transition: border-color 0.3s var(--jci-ease), background-color 0.3s var(--jci-ease),
      transform 0.35s var(--jci-ease);
  }

  .jci-header-icon-button > * {
    position: relative;
    z-index: 1;
  }

  .jci-header-icon-button svg {
    width: var(--jci-header-icon-size);
    height: var(--jci-header-icon-size);
    fill: none;
    stroke: currentcolor;
    stroke-width: var(--jci-header-icon-stroke);
    transition: transform 0.35s var(--jci-ease);
  }

  .jci-header-icon-button:hover,
  .jci-header-icon-button:focus-visible {
    color: var(--jci-header-nav-hover);
    transform: translateY(-2px);
  }

  .jci-header-icon-button:hover::before,
  .jci-header-icon-button:focus-visible::before {
    border-color: rgb(var(--jci-olive-rgb) / 0.35);
    background: rgb(var(--jci-olive-rgb) / 0.07);
    transform: scale(1);
  }

  .jci-header-icon-button:hover svg,
  .jci-header-icon-button:focus-visible svg {
    transform: scale(1.08) rotate(-6deg);
  }

.jci-header-action-label, .jci-header-menu-label {
    font-family: var(--jci-font-label);
    font-size: var(--jci-header-label-size);
    text-transform: uppercase;
    FONT-WEIGHT: 400;
}

  /* --- Cart count --- */
  .jci-header-cart-trigger {
    position: relative;
  }

  .jci-header-cart-count {
    display: inline-grid;
    place-items: center;
    min-width: var(--jci-header-badge-size);
    height: var(--jci-header-badge-size);
    margin-inline-start: -0.25rem;
    padding-inline: 0.2rem;
    color: var(--jci-header-bg);
    background: var(--jci-header-badge-bg);
    border-radius: 50%;
    font-family: var(--jci-font-label);
    font-size: 9px;
    transition: background-color 0.3s var(--jci-ease), transform 0.3s var(--jci-ease);
  }

  .jci-header-cart-trigger:hover .jci-header-cart-count,
  .jci-header-cart-trigger:focus-visible .jci-header-cart-count {
    background: var(--jci-header-badge-hover-bg);
    transform: translate(1px, -2px);
  }

  /* --- Mobile menu trigger --- */
  .jci-header-menu-trigger {
    display: none;
  }

  .jci-header-menu-icon {
    display: flex;
    flex-direction: column;
    gap: 4px;
    width: 17px;
  }

  .jci-header-menu-icon i {
    display: block;
    width: 100%;
    height: 1px;
    background: currentcolor;
    transition: transform 0.25s var(--jci-ease);
  }

  .jci-header-menu-trigger[aria-expanded='true'] .jci-header-menu-icon i:first-child {
    transform: translateY(2.5px) rotate(45deg);
  }

  .jci-header-menu-trigger[aria-expanded='true'] .jci-header-menu-icon i:last-child {
    transform: translateY(-2.5px) rotate(-45deg);
  }

  /* --- Mobile drawer --- */
  .jci-header-backdrop {
    position: fixed;
    inset: 0;
    z-index: 20;
    background: rgb(15 17 14 / 0.48);
    opacity: 0;
    transition: opacity 0.4s var(--jci-ease);
  }

  .jci-header-backdrop.is-visible {
    opacity: 1;
  }

  .jci-header-backdrop[hidden] {
    display: none;
  }

  .jci-header-drawer {
    position: fixed;
    inset-block: 0;
    inset-inline-start: 0;
    z-index: 30;
    isolation: isolate;
    overflow: hidden;
    width: min(var(--jci-header-drawer-width), 91vw);
    padding: 1.5rem var(--jci-page-pad);
    color: var(--color-foreground);
    background: var(--jci-header-drawer-bg);
    box-shadow: 0 0 40px rgb(15 17 14 / 0.14);
    transform: translateX(-105%);
    transition: transform 0.45s var(--jci-ease);
  }

  .jci-header-drawer.is-open {
    transform: translateX(0);
  }

  /* Oversized monogram watermark behind the drawer content. */
  .jci-header-drawer::before {
    content: 'MC';
    position: absolute;
    inset-inline-end: -0.08em;
    inset-block-end: -0.08em;
    z-index: -1;
    color: rgb(var(--jci-olive-rgb) / 0.13);
    font-family: var(--jci-font-display);
    font-size: clamp(14rem, 53vw, 25rem);
    font-weight: 600;
    pointer-events: none;
  }

  .jci-header-drawer-head {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-block-end: 1rem;
    border-block-end: 1px solid var(--jci-line);
  }

  .jci-header-drawer-head .jci-eyebrow {
    color: var(--jci-olive);
  }

  .jci-header-drawer-back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.35rem 0;
    border: 0;
    color: inherit;
    background: transparent;
    font-family: var(--jci-font-label);
    font-size: 9px;
    text-transform: uppercase;
    cursor: pointer;
  }

  .jci-header-drawer-back-icon {
    width: 14px;
    height: 14px;
    transition: transform 0.3s var(--jci-ease);
  }

  .jci-header-drawer-back:hover .jci-header-drawer-back-icon,
  .jci-header-drawer-back:focus-visible .jci-header-drawer-back-icon {
    transform: translateX(-3px);
  }

  .jci-header-drawer-intro {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-block-start: clamp(2.3rem, 10vw, 4rem);
    padding-block-end: 0.85rem;
    border-block-end: 1px solid var(--jci-line);
    color: var(--jci-stone);
    font-family: var(--jci-font-label);
    font-size: 8px;
    text-transform: uppercase;
  }

  .jci-header-drawer-intro .jci-eyebrow {
    color: var(--jci-olive);
  }

  .jci-header-drawer-nav {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1fr;
    padding-block-start: 0.35rem;
  }

  /* The drawer link is 28px display type; the arrow stays at label size. */
  .jci-header-drawer-arrow {
    flex: 0 0 16px;
    width: 16px;
    height: 16px;
    align-self: center;
  }

  .jci-header-drawer-link {
    display: flex;
    justify-content: space-between;
    padding-block: 1rem;
    border-block-end: 1px solid var(--jci-line);
    color: inherit;
    font-family: var(--jci-font-display);
    font-size: 28px;
    text-decoration: none;
  }

  .jci-header-drawer-link span {
    font-family: var(--jci-font-sans);
    font-size: 17px;
  }

  .jci-header-drawer-back:focus-visible,
  .jci-header-drawer-link:focus-visible {
    outline: 2px solid var(--jci-rust);
    outline-offset: 4px;
  }

  .jci-header-drawer-footer {
    position: absolute;
    inset-inline: var(--jci-page-pad);
    inset-block-end: 2.5rem;
    z-index: 1;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-start: 1.3rem;
    border-block-start: 1px solid var(--jci-line);
    font-family: var(--jci-font-label);
    font-size: 9px;
    text-transform: uppercase;
  }

  @keyframes jci-header-reveal {
    from {
      opacity: 0;
      transform: translateY(-14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes jci-header-logo-reveal {
    from {
      opacity: 0;
      transform: translateY(-8px) scale(0.96);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes jci-header-glint {
    0%,
    55% {
      opacity: 0;
      transform: translateX(-120%);
    }

    65% {
      opacity: 1;
    }

    100% {
      opacity: 0;
      transform: translateX(120%);
    }
  }

  @media screen and (max-width: 900px) {
    .jci-header-nav {
      gap: 1rem;
    }

    .jci-header[data-jci-hide-labels-tablet] .jci-header-action-label {
      display: none;
    }
  }

  @media screen and (max-width: 680px) {
    .jci-header-container {
      grid-template-columns: minmax(34px, 1fr) auto minmax(0, 1fr);
      gap: 0.5rem;
      min-height: var(--jci-header-height-mobile);
      padding-block: 0.65rem;
    }

    .jci-header-nav {
      display: none;
    }

    .jci-header[data-jci-hide-account-mobile] .jci-header-account-trigger {
      display: none;
    }

    .jci-header-menu-trigger {
      display: inline-flex;
      justify-content: flex-start;
      min-width: 34px;
    }

    .jci-header-actions {
      gap: 0.55rem;
    }

    .jci-header-search-trigger,
    .jci-header-cart-trigger {
      justify-content: center;
      min-width: 34px;
    }

    .jci-header-search-trigger svg,
    .jci-header-cart-trigger svg {
      width: 18px;
      height: 18px;
    }

    .jci-header-wordmark {
      width: min(var(--jci-header-logo-width-mobile), 46vw);
      height: var(--jci-header-logo-height-mobile);
    }

    .jci-header-drawer {
      width: 100%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-header,
    .jci-header::before,
    .jci-header-wordmark {
      animation: none;
    }

    .jci-header-nav-link,
    .jci-header-nav-link::before,
    .jci-header-nav-link::after,
    .jci-header-icon-button,
    .jci-header-icon-button::before,
    .jci-header-icon-button svg,
    .jci-header-drawer,
    .jci-header-backdrop {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Header",
  "tag": "header",
  "class": "jci-header-section",
  "enabled_on": {
    "groups": ["header"]
  },
  "settings": [
    { "type": "header", "content": "Navigation" },
    { "type": "link_list", "id": "menu", "label": "Menu", "default": "main-menu" },
    { "type": "range", "id": "nav_font_size", "label": "Link size", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "nav_gap", "label": "Space between links", "min": 8, "max": 60, "step": 1, "unit": "px", "default": 40 },
    { "type": "color", "id": "nav_hover_color", "label": "Hover color", "default": "#737960" },
    { "type": "color", "id": "nav_dot_color", "label": "Hover dot color", "default": "#98634b" },

    { "type": "header", "content": "Logo" },
    { "type": "paragraph", "content": "Upload a logo in Theme settings. With none uploaded, the wordmark bundled in the theme assets is used." },
    { "type": "range", "id": "logo_width", "label": "Width", "min": 100, "max": 400, "step": 5, "unit": "px", "default": 250 },
    { "type": "range", "id": "logo_height", "label": "Height", "min": 30, "max": 140, "step": 2, "unit": "px", "default": 78 },
    { "type": "range", "id": "logo_width_mobile", "label": "Width on mobile", "min": 80, "max": 300, "step": 5, "unit": "px", "default": 170 },
    { "type": "range", "id": "logo_height_mobile", "label": "Height on mobile", "min": 30, "max": 100, "step": 1, "unit": "px", "default": 58 },

    { "type": "header", "content": "Actions" },
    { "type": "checkbox", "id": "show_search", "label": "Show search", "default": true },
    { "type": "checkbox", "id": "show_account", "label": "Show account", "default": true },
    { "type": "checkbox", "id": "show_cart", "label": "Show bag", "default": true },
    { "type": "range", "id": "label_size", "label": "Label size", "min": 8, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "checkbox", "id": "hide_labels_tablet", "label": "Hide labels below 900px", "default": true },
    { "type": "checkbox", "id": "hide_account_mobile", "label": "Hide account below 680px", "default": true },
    { "type": "range", "id": "icon_size", "label": "Icon size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "icon_stroke_width", "label": "Icon stroke width", "min": 100, "max": 300, "step": 5, "unit": "%", "default": 135 },
    { "type": "range", "id": "cart_badge_size", "label": "Bag count size", "min": 12, "max": 26, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "cart_badge_color", "label": "Bag count background", "default": "#1e211d" },
    { "type": "color", "id": "cart_badge_hover_color", "label": "Bag count hover background", "default": "#98634b" },

    { "type": "header", "content": "Height" },
    { "type": "range", "id": "height", "label": "Height", "min": 50, "max": 140, "step": 1, "unit": "px", "default": 86 },
    { "type": "range", "id": "height_mobile", "label": "Height on mobile", "min": 40, "max": 120, "step": 1, "unit": "px", "default": 70 },
    { "type": "checkbox", "id": "shrink_on_scroll", "label": "Shrink when scrolled", "default": true },
    { "type": "range", "id": "height_scrolled", "label": "Height when scrolled", "min": 40, "max": 120, "step": 1, "unit": "px", "default": 58, "visible_if": "{{ section.settings.shrink_on_scroll }}" },
    { "type": "range", "id": "logo_height_scrolled", "label": "Logo height when scrolled", "min": 30, "max": 120, "step": 1, "unit": "px", "default": 50, "visible_if": "{{ section.settings.shrink_on_scroll }}" },

    { "type": "header", "content": "Surface" },
    { "type": "checkbox", "id": "enable_sticky", "label": "Stick to top when scrolling", "default": true },
    { "type": "color", "id": "background_color", "label": "Background", "default": "#fbfaf7" },
    { "type": "color", "id": "text_color", "label": "Text", "default": "#1e211d" },
    { "type": "range", "id": "backdrop_blur", "label": "Backdrop blur", "min": 0, "max": 40, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "backdrop_saturate", "label": "Backdrop saturation", "min": 100, "max": 200, "step": 5, "unit": "%", "default": 115 },
    { "type": "range", "id": "bg_opacity_top", "label": "Background opacity (top)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 84 },
    { "type": "range", "id": "bg_opacity_bottom", "label": "Background opacity (bottom)", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 72 },
    { "type": "range", "id": "bg_opacity_scrolled", "label": "Background opacity when scrolled", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 80 },
    { "type": "range", "id": "border_opacity", "label": "Bottom border opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 12 },

    { "type": "header", "content": "Mobile drawer" },
    { "type": "range", "id": "drawer_width", "label": "Width", "min": 280, "max": 600, "step": 10, "unit": "px", "default": 420 },
    { "type": "color", "id": "drawer_background_color", "label": "Background", "default": "#f3f0e8" },
    { "type": "text", "id": "drawer_eyebrow", "label": "Eyebrow", "default": "Explore the Maison" },
    { "type": "text", "id": "drawer_count_label", "label": "Count label", "default": "destinations" },
    { "type": "text", "id": "drawer_footer_left", "label": "Footer left", "default": "MC / 2026" },
    { "type": "text", "id": "drawer_footer_right", "label": "Footer right", "default": "Fewer, better pieces." },

    { "type": "header", "content": "Motion" },
    { "type": "checkbox", "id": "enable_reveal", "label": "Reveal header on load", "default": true },
    { "type": "checkbox", "id": "enable_glint", "label": "Light sweep on load", "default": true }
  ],
  "presets": [
    {
      "name": "Header"
    }
  ]
}
{% endschema %}
