{% comment %}
  Maison Cavallé — footer
  Prototype source: maison-cavalle-main/index.html → .site-footer
                    maison-cavalle-main/styles.css → .site-footer, .footer-*
                    (63–64, 1293–1316, 1444–1445, 1606–1615)
  Reference: MAISON-CAVALLE-SPEC.md §1

  An ink panel: brand, two link columns, a journal sign-off, then a bottom rule
  carrying the copyright and credit.

  Link columns are blocks backed by a navigation menu, so the links are managed
  in Shopify's Navigation rather than retyped here.

  The prototype cascades four .site-footer rules; the values that survive are
  what is reproduced — content-width panel, block padding only, gutters left to
  the container.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign columns = section.blocks | where: 'type', 'column'

  assign logo_src = blank
  if s.logo != blank
    assign logo_src = s.logo | image_url: width: 420
  elsif s.logo_asset != blank
    assign logo_src = s.logo_asset | strip | asset_url
  endif
%}

<footer
  class="jci-footer"
  style="
    --jci-footer-bg: {{ s.background_color | default: settings.color_palette.foreground }};
    --jci-footer-text: {{ s.text_color | default: settings.color_palette.background }};
    --jci-footer-text-rgb: {{ s.text_color.rgb | default: settings.color_palette.background.rgb }};
    --jci-footer-accent: {{ s.accent_color }};
    --jci-footer-body: {{ s.body_color }};
    --jci-footer-link: {{ s.link_color }};
    --jci-footer-bottom: {{ s.bottom_color }};
    --jci-footer-rule-opacity: {{ s.rule_opacity | divided_by: 100.0 }};
    --jci-footer-space-above: {{ s.space_above }}px;
    --jci-footer-pad-top: {% render 'jci-fluid-space', max: s.padding_top %};
    --jci-footer-pad-bottom: {% render 'jci-fluid-space', max: s.padding_bottom %};
    --jci-footer-top-gap: {{ s.top_gap }}px;
    --jci-footer-top-space: {{ s.top_space }}px;
    --jci-footer-logo-width: {{ s.logo_width }}px;
    --jci-footer-heading-size: {{ s.heading_size }}px;
    --jci-footer-link-size: {{ s.link_size }}px;
    {%- if s.background_width == 'full' %}
      --jci-container-width: var(--jci-page-column);
      --jci-container-offset: calc(50% - var(--jci-page-column) / 2);
    {%- endif %}
  "
>
  <div class="jci-footer-container">
    <div class="jci-footer-top">
      <div class="jci-footer-brand">
        {%- if logo_src != blank -%}
          <a class="jci-footer-wordmark" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
            <img
              class="jci-footer-logo"
              src="{{ logo_src }}"
              alt="{{ shop.name | escape }}"
              width="{{ s.logo.width | default: 420 }}"
              height="{{ s.logo.height | default: 130 }}"
              loading="lazy"
            >
          </a>
        {%- endif -%}

        {%- if s.tagline != blank -%}
          <p class="jci-footer-tagline">{{ s.tagline | newline_to_br }}</p>
        {%- endif -%}
      </div>

      {%- for block in columns -%}
        {%- liquid
          assign b = block.settings
          assign menu = b.menu
          assign heading = b.heading | default: menu.title
        -%}
        <div class="jci-footer-column" {{ block.shopify_attributes }}>
          {%- if heading != blank -%}
            <h2 class="jci-footer-column-heading">{{ heading }}</h2>
          {%- endif -%}
          {%- for link in menu.links -%}
            <a class="jci-footer-column-link" href="{{ link.url }}">{{ link.title }}</a>
          {%- endfor -%}
        </div>
      {%- endfor -%}

      {%- if s.signoff_title != blank or s.signoff_body != blank or s.signoff_link_label != blank -%}
        <div class="jci-footer-signoff">
          {%- if s.signoff_eyebrow != blank -%}
            <p class="jci-eyebrow jci-footer-signoff-eyebrow">{{ s.signoff_eyebrow }}</p>
          {%- endif -%}
          {%- if s.signoff_title != blank -%}
            <h2 class="jci-footer-signoff-title">{{ s.signoff_title }}</h2>
          {%- endif -%}
          {%- if s.signoff_body != blank -%}
            <p class="jci-footer-signoff-body">{{ s.signoff_body }}</p>
          {%- endif -%}
          {%- if s.signoff_link_label != blank -%}
            <a class="jci-footer-link" href="{{ s.signoff_link_url | default: routes.root_url }}">
              {{ s.signoff_link_label }} {% render 'jci-action-arrow', class: 'jci-footer-link-arrow' %}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="jci-footer-bottom">
      {%- comment -%}
        The year is rendered, not typed, so a stale copyright cannot ship.
      {%- endcomment -%}
      <span class="jci-footer-copyright">
        &copy; {{ 'now' | date: '%Y' }} {{ s.copyright_name | default: shop.name }}
      </span>

      {%- if s.credit_label != blank -%}
        <a class="jci-footer-credit" href="{{ s.credit_url }}" target="_blank" rel="noreferrer">
          {{- s.credit_prefix }} <span class="jci-footer-credit-name">{{ s.credit_label }}</span>
        </a>
      {%- endif -%}
    </div>
  </div>
</footer>

{% stylesheet %}
  /* The panel is capped at the content width and centred, the way #app caps it
     in the prototype — the gutters belong to the container inside. */
  .jci-footer {
    position: relative;
    display: block;
    width: var(--jci-container-width, min(100%, var(--jci-content-max)));
    margin-inline: var(--jci-container-offset, auto) auto;
    margin-block-start: var(--jci-footer-space-above);
    padding-block: var(--jci-footer-pad-top) var(--jci-footer-pad-bottom);
    color: var(--jci-footer-text);
    background: var(--jci-footer-bg);
  }

  /* Hairline across the top, stopping at the gutters. */
  .jci-footer::before {
    content: "";
    position: absolute;
    top: 0;
    right: var(--jci-page-pad);
    left: var(--jci-page-pad);
    height: 1px;
    background: rgb(var(--jci-footer-text-rgb) / var(--jci-footer-rule-opacity));
  }

  /* -- Top row ----------------------------------------------------------- */

  .jci-footer-top {
    display: grid;
    grid-template-columns: 1.2fr 0.7fr 0.7fr 1.25fr;
    gap: var(--jci-footer-top-gap);
    padding-bottom: var(--jci-footer-top-space);
  }

  .jci-footer-wordmark {
    display: flex;
    align-items: flex-start;
    width: min(var(--jci-footer-logo-width), 100%);
  }

  .jci-footer-logo {
    width: 100%;
    height: auto;
    object-fit: contain;
  }

  .jci-footer-tagline {
    margin: 1.5rem 0 0;
    color: var(--jci-footer-body);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  /* -- Link columns ------------------------------------------------------ */

  .jci-footer-column {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.8rem;
  }

  .jci-footer-column-heading,
  .jci-footer-signoff-title {
    margin: 0 0 0.7rem;
    font-family: var(--jci-font-display);
    font-size: var(--jci-footer-heading-size);
    font-weight: 500;
  }

  .jci-footer-column-link {
    position: relative;
    padding-bottom: 0.15rem;
    color: var(--jci-footer-link);
    font-size: var(--jci-footer-link-size);
    text-decoration: none;
  }

  /* Underline drawn from the left on hover. */
  .jci-footer-column-link::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    width: 0;
    height: 1px;
    background: currentcolor;
    transition: width 0.3s var(--jci-ease);
  }

  .jci-footer-column-link:hover::after,
  .jci-footer-column-link:focus-visible::after {
    width: 100%;
  }

  /* -- Sign-off ---------------------------------------------------------- */

  .jci-footer-signoff {
    max-width: 330px;
    margin-left: auto;
  }

  .jci-footer-signoff-eyebrow {
    margin-bottom: 0.7rem;
    color: var(--jci-footer-accent);
  }

  .jci-footer-signoff-body {
    margin: 0 0 1.4rem;
    color: var(--jci-footer-link);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  .jci-footer-link {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding-bottom: 0.45rem;
    color: var(--jci-footer-text);
    border-bottom: 1px solid rgb(var(--jci-footer-text-rgb) / 0.55);
    font-family: var(--jci-font-label);
    font-size: 14px;
    text-decoration: none;
    text-transform: uppercase;
  }

  .jci-footer-link-arrow {
    flex: 0 0 14px;
    width: 14px;
    height: 14px;
  }

  .jci-footer-link:hover .jci-footer-link-arrow {
    transform: translate(3px, -3px);
  }

  /* -- Bottom row -------------------------------------------------------- */

  .jci-footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    padding-top: 1.3rem;
    color: var(--jci-footer-bottom);
    border-top: 1px solid rgb(var(--jci-footer-text-rgb) / var(--jci-footer-rule-opacity));
    font-family: var(--jci-font-label);
    font-size: 14px;
  }

  .jci-footer-credit {
    color: inherit;
    text-decoration: none;
  }

  .jci-footer-credit-name {
    padding-bottom: 0.12rem;
    border-bottom: 1px solid currentcolor;
  }

  /* -- Breakpoints (§5 — 900 and 680 only) ------------------------------- */

  @media screen and (max-width: 900px) {
    .jci-footer-top {
      grid-template-columns: 1fr 1fr 1fr;
    }

    .jci-footer-signoff {
      grid-column: 1 / -1;
      margin-left: 0;
    }
  }

  @media screen and (max-width: 680px) {
    .jci-footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 2.7rem 1.5rem;
      padding-bottom: 3.5rem;
      text-align: center;
    }

    .jci-footer-brand,
    .jci-footer-signoff {
      grid-column: 1 / -1;
    }

    .jci-footer-wordmark {
      margin-inline: auto;
      align-items: center;
    }

    .jci-footer-column {
      align-items: center;
    }

    .jci-footer-signoff {
      width: 100%;
      max-width: 100%;
      margin-inline: auto;
      text-align: center;
    }

    /* Both lines go full width and centre, so neither wraps awkwardly. */
    .jci-footer-bottom {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.7rem;
      text-align: center;
    }

    .jci-footer-credit {
      white-space: nowrap;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-footer-column-link::after {
      transition: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "tag": "div",
  "class": "jci-footer-wrapper",
  "max_blocks": 4,
  "settings": [
    { "type": "header", "content": "Brand" },
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "logo_asset", "label": "Logo asset filename", "default": "jci-logo-inverse.svg", "info": "A file in assets/. Used only when no logo is chosen." },
    { "type": "range", "id": "logo_width", "label": "Logo width", "min": 100, "max": 360, "step": 5, "unit": "px", "default": 210 },
    { "type": "textarea", "id": "tagline", "label": "Tagline", "default": "Fewer, better pieces.\nBorn from a life with horses." },

    { "type": "header", "content": "Sign-off" },
    { "type": "text", "id": "signoff_eyebrow", "label": "Eyebrow", "default": "From the journal" },
    { "type": "text", "id": "signoff_title", "label": "Title", "default": "Notes from the stable." },
    { "type": "textarea", "id": "signoff_body", "label": "Body", "default": "Stories of horses, craft and the everyday rituals that make a life feel well lived." },
    { "type": "text", "id": "signoff_link_label", "label": "Link label", "default": "Read the journal" },
    { "type": "url", "id": "signoff_link_url", "label": "Link" },

    { "type": "header", "content": "Bottom row" },
    { "type": "text", "id": "copyright_name", "label": "Copyright name", "info": "Left empty, the store name is used. The year is always current." },
    { "type": "text", "id": "credit_prefix", "label": "Credit prefix", "default": "Designed by" },
    { "type": "text", "id": "credit_label", "label": "Credit name", "default": "Just Create It" },
    { "type": "url", "id": "credit_url", "label": "Credit link" },

    { "type": "header", "content": "Colors", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Headings and rules" },
    { "type": "color", "id": "accent_color", "label": "Eyebrow", "default": "#c6cda9" },
    { "type": "color", "id": "body_color", "label": "Tagline", "default": "#bac0b2" },
    { "type": "color", "id": "link_color", "label": "Links and body", "default": "#bec3b7" },
    { "type": "color", "id": "bottom_color", "label": "Bottom row", "default": "#92998b" },
    { "type": "range", "id": "rule_opacity", "label": "Rule opacity", "min": 0, "max": 100, "step": 1, "unit": "%", "default": 18 },

    { "type": "header", "content": "Layout" },
    {
      "type": "select", "id": "background_width", "label": "Panel width",
      "options": [
        { "value": "content", "label": "Content width" },
        { "value": "full", "label": "Full width" }
      ],
      "default": "content"
    },
    { "type": "range", "id": "space_above", "label": "Space above the panel", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 32 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 200, "step": 4, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "top_gap", "label": "Column gap", "min": 16, "max": 120, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "top_space", "label": "Space above the bottom row", "min": 24, "max": 200, "step": 4, "unit": "px", "default": 80 },
    { "type": "range", "id": "heading_size", "label": "Column heading size", "min": 12, "max": 32, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "link_size", "label": "Link size", "min": 10, "max": 20, "step": 1, "unit": "px", "default": 12 }
  ],
  "blocks": [
    {
      "type": "column",
      "name": "Link column",
      "settings": [
        { "type": "link_list", "id": "menu", "label": "Menu" },
        { "type": "text", "id": "heading", "label": "Heading", "info": "Left empty, the menu's own name is used." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "column", "settings": { "heading": "Explore" } },
        { "type": "column", "settings": { "heading": "Care" } }
      ]
    }
  ]
}
{% endschema %}
