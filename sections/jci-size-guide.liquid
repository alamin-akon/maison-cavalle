{% comment %}
  Maison Cavallé — size guide measurements

  Prototype source: maison-cavalle-main/app.js     → renderSizeGuidePage, section.size-details
                    maison-cavalle-main/styles.css  → .size-details, .size-overview-head,
                                                      .size-table-*, .size-measure-* (781-796),
                                                      .size-table (1259-1263), @680 (1814-1818)
  Reference: MAISON-CAVALLE-SPEC.md §0, §1, §3, §5, §7

  A header, the size chart and the three "how to measure" cards. Every chart
  row and every card is a block, so sizes can be added or changed without code.

  The prototype narrows this page to 1180px and gives it its own .section
  padding; per §0 it takes the shared container and rhythm instead.
  `.size-table-wrap` is declared twice in styles.css — :1259 wins the cascade,
  so the chart sits 2.7rem below the header and scrolls sideways when narrow.
  No letter-spacing or line-height is authored (§0).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign rows = section.blocks | where: 'type', 'row'
  assign measures = section.blocks | where: 'type', 'measure'
-%}

<section
  class="jci-size-guide"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="
    --jci-size-guide-bg: {{ s.background_color | default: settings.color_palette.background }};
    --jci-size-guide-card-bg: {{ s.card_background | default: settings.color_palette.color3 }};
    --jci-size-guide-row-hover: {{ s.row_hover_color | default: settings.color_palette.color3 }};
    --jci-size-guide-pad-top: {{ s.padding_top }}px;
    --jci-size-guide-pad-bottom: {{ s.padding_bottom }}px;
    --jci-size-guide-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-size-guide-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="jci-size-guide-container">
    {%- if s.eyebrow != blank or s.title_line_one != blank or s.intro != blank -%}
      <div class="jci-size-guide-head">
        <div class="jci-size-guide-head-copy">
          {%- if s.eyebrow != blank -%}
            <p class="jci-eyebrow jci-size-guide-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.title_line_one != blank or s.title_line_two != blank -%}
            <h2 class="jci-size-guide-title">
              {{- s.title_line_one -}}
              {%- if s.title_line_one != blank and s.title_line_two != blank -%}<br>{%- endif -%}
              {%- if s.title_line_two != blank -%}
                <em class="jci-size-guide-title-accent">{{ s.title_line_two }}</em>
              {%- endif -%}
            </h2>
          {%- endif -%}
        </div>

        {%- if s.intro != blank -%}
          <p class="jci-size-guide-intro">{{ s.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- if rows.size > 0 -%}
      <div class="jci-size-guide-table-wrap">
        <table class="jci-size-guide-table">
          {%- if s.caption != blank -%}
            <caption class="jci-size-guide-caption">{{ s.caption }}</caption>
          {%- endif -%}
          <thead>
            <tr class="jci-size-guide-head-row">
              {%- for i in (1..5) -%}
                {%- assign heading_key = 'column_' | append: i -%}
                {%- if s[heading_key] != blank -%}
                  <th
                    class="jci-size-guide-heading"
                    scope="col"
                  >
                    {{ s[heading_key] }}
                  </th>
                {%- endif -%}
              {%- endfor -%}
            </tr>
          </thead>
          <tbody>
            {%- for block in rows -%}
              <tr
                class="jci-size-guide-row"
                {{ block.shopify_attributes }}
              >
                {%- for i in (1..5) -%}
                  {%- liquid
                    assign heading_key = 'column_' | append: i
                    assign cell_key = 'cell_' | append: i
                    if s[heading_key] == blank
                      continue
                    endif
                  -%}
                  {%- if forloop.first -%}
                    <th
                      class="jci-size-guide-cell jci-size-guide-cell-size"
                      scope="row"
                    >
                      {{ block.settings[cell_key] }}
                    </th>
                  {%- else -%}
                    <td class="jci-size-guide-cell">{{ block.settings[cell_key] }}</td>
                  {%- endif -%}
                {%- endfor -%}
              </tr>
            {%- endfor -%}
          </tbody>
        </table>
      </div>
    {%- endif -%}

    {%- if measures.size > 0 -%}
      <div class="jci-size-guide-measures">
        {%- for block in measures -%}
          {%- assign bs = block.settings -%}
          <article
            class="jci-size-guide-measure"
            {{ block.shopify_attributes }}
          >
            <span class="jci-size-guide-measure-index">
              {{- bs.index | default: forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>
            {%- if bs.eyebrow != blank -%}
              <p class="jci-eyebrow jci-size-guide-measure-eyebrow">{{ bs.eyebrow }}</p>
            {%- endif -%}
            {%- if bs.title != blank -%}
              <h3 class="jci-size-guide-measure-title">{{ bs.title }}</h3>
            {%- endif -%}
            {%- if bs.text != blank -%}
              <p class="jci-size-guide-measure-text">{{ bs.text }}</p>
            {%- endif -%}
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .jci-size-guide {
    display: block;
    padding-block: var(--jci-size-guide-pad-top) var(--jci-size-guide-pad-bottom);
    background: var(--jci-size-guide-bg);
  }

  /* styles.css:782-785 — #65695f is ink at 68% on paper. */
  .jci-size-guide-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(260px, 0.7fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
    padding-bottom: 2rem;
    border-bottom: 1px solid var(--jci-line);
  }

  .jci-size-guide-eyebrow {
    color: var(--jci-ink);
  }

  .jci-size-guide-title {
    margin: 0.8rem 0 0;
    color: var(--jci-ink);
    font-family: var(--jci-font-display);
    font-size: var(--jci-section-title-size);
    font-weight: 500;
  }

  .jci-size-guide-title-accent {
    color: var(--jci-olive);
    font-style: italic;
  }

  .jci-size-guide-intro {
    max-width: 390px;
    margin: 0;
    color: rgb(var(--jci-ink-rgb) / 0.68);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  /* styles.css:1259 — the later of the two declarations. */
  .jci-size-guide-table-wrap {
    overflow-x: auto;
    margin-top: 2.7rem;
  }

  /* styles.css:1260 */
  .jci-size-guide-table {
    width: 100%;
    min-width: 560px;
    border-collapse: collapse;
    text-align: left;
  }

  /* styles.css:787 — #777b70 is ink at 60% on paper. */
  .jci-size-guide-caption {
    margin-bottom: 0.9rem;
    color: rgb(var(--jci-ink-rgb) / 0.6);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-align: left;
    text-transform: uppercase;
  }

  /* styles.css:1261 */
  .jci-size-guide-heading {
    padding: 0.9rem 0.7rem;
    color: var(--jci-olive);
    border-bottom: 1px solid var(--jci-ink);
    font-family: var(--jci-font-label);
    font-size: 14px;
    font-weight: 400;
    text-transform: uppercase;
  }

  /* styles.css:788-789 */
  .jci-size-guide-row {
    transition: background 0.25s var(--jci-ease);
  }

  .jci-size-guide-row:hover {
    background: var(--jci-size-guide-row-hover);
  }

  /* styles.css:1262 */
  .jci-size-guide-cell {
    padding: 1.2rem 0.7rem;
    color: var(--jci-ink);
    border-bottom: 1px solid var(--jci-line);
    font-family: var(--jci-font-sans);
    font-size: 13px;
    font-weight: 400;
    text-align: left;
  }

  /* styles.css:1263 — the prototype reaches this with td:first-child; the
     size column is its own row header here (§1). */
  .jci-size-guide-cell-size {
    font-family: var(--jci-font-display);
    font-size: 18px;
  }

  /* styles.css:790 */
  .jci-size-guide-measures {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-top: 3.5rem;
  }

  /* styles.css:791-792 */
  .jci-size-guide-measure {
    position: relative;
    min-height: 205px;
    padding: 1.5rem;
    border: 1px solid var(--jci-line);
    background: var(--jci-size-guide-card-bg);
    transition:
      transform 0.35s var(--jci-ease),
      border-color 0.35s var(--jci-ease),
      box-shadow 0.35s var(--jci-ease);
  }

  .jci-size-guide-measure:hover {
    border-color: rgb(var(--jci-rust-rgb) / 0.5);
    box-shadow: 8px 10px 0 rgb(var(--jci-ink-rgb) / 0.06);
    transform: translateY(-5px);
  }

  /* styles.css:793 */
  .jci-size-guide-measure-index {
    position: absolute;
    top: 1.5rem;
    right: 1.5rem;
    color: var(--jci-rust);
    font-family: var(--jci-font-label);
    font-size: 14px;
  }

  /* styles.css:794 */
  .jci-size-guide-measure-eyebrow {
    margin-bottom: 2rem;
    color: var(--jci-olive);
  }

  /* styles.css:795 */
  .jci-size-guide-measure-title {
    max-width: 210px;
    margin: 0 0 0.65rem;
    color: var(--jci-ink);
    font-family: var(--jci-font-display);
    font-size: 24px;
    font-weight: 500;
  }

  /* styles.css:796 */
  .jci-size-guide-measure-text {
    max-width: 250px;
    margin: 0;
    color: rgb(var(--jci-ink-rgb) / 0.68);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  /* styles.css:@680 (1814-1818) */
  @media screen and (max-width: 680px) {
    .jci-size-guide {
      padding-block: var(--jci-size-guide-pad-top-mobile) var(--jci-size-guide-pad-bottom-mobile);
    }

    .jci-size-guide-head {
      display: block;
    }

    .jci-size-guide-intro {
      margin-top: 1.8rem;
    }

    .jci-size-guide-measures {
      grid-template-columns: 1fr;
      margin-top: 2.4rem;
    }

    .jci-size-guide-measure {
      min-height: 170px;
    }

    .jci-size-guide-measure-eyebrow {
      margin-bottom: 1.6rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-size-guide-row,
    .jci-size-guide-measure {
      transition: none;
    }

    .jci-size-guide-measure:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Size guide",
  "tag": "div",
  "class": "jci-size-guide-section",
  "blocks": [
    {
      "type": "row",
      "name": "Size row",
      "settings": [
        { "type": "text", "id": "cell_1", "label": "Column 1", "default": "XS" },
        { "type": "text", "id": "cell_2", "label": "Column 2", "default": "6–8" },
        { "type": "text", "id": "cell_3", "label": "Column 3", "default": "80–85" },
        { "type": "text", "id": "cell_4", "label": "Column 4", "default": "62–67" },
        { "type": "text", "id": "cell_5", "label": "Column 5", "default": "88–93" }
      ]
    },
    {
      "type": "measure",
      "name": "Measuring card",
      "limit": 6,
      "settings": [
        { "type": "text", "id": "index", "label": "Number", "info": "Leave empty to number automatically." },
        { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Bust" },
        { "type": "text", "id": "title", "label": "Title", "default": "Across the fullest point." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Keep the tape level around your chest, without pulling it tight." }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Women’s tops" },
    { "type": "text", "id": "title_line_one", "label": "Title first line", "default": "Choose your" },
    { "type": "text", "id": "title_line_two", "label": "Title second line (italic)", "default": "usual size." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Our tops are designed for an easy, considered fit. Measure over a light layer and choose the size that feels most like you. If you are between sizes, we recommend choosing the larger size." },

    { "type": "header", "content": "Size chart" },
    { "type": "text", "id": "caption", "label": "Caption", "default": "Maison Cavallé women’s tops size chart" },
    { "type": "text", "id": "column_1", "label": "Column 1 heading", "default": "Size" },
    { "type": "text", "id": "column_2", "label": "Column 2 heading", "default": "AU / UK" },
    { "type": "text", "id": "column_3", "label": "Column 3 heading", "default": "Bust (cm)" },
    { "type": "text", "id": "column_4", "label": "Column 4 heading", "default": "Waist (cm)" },
    { "type": "text", "id": "column_5", "label": "Column 5 heading", "default": "Hip (cm)", "info": "Leave a heading empty to drop that column." },

    { "type": "header", "content": "Colors", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "card_background", "label": "Card background" },
    { "type": "color", "id": "row_hover_color", "label": "Row hover" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Anchor" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "size-details", "info": "The hero's links point here." }
  ],
  "presets": [
    {
      "name": "Size guide",
      "blocks": [
        { "type": "row", "settings": { "cell_1": "XS", "cell_2": "6–8", "cell_3": "80–85", "cell_4": "62–67", "cell_5": "88–93" } },
        { "type": "row", "settings": { "cell_1": "S", "cell_2": "8–10", "cell_3": "85–90", "cell_4": "67–72", "cell_5": "93–98" } },
        { "type": "row", "settings": { "cell_1": "M", "cell_2": "10–12", "cell_3": "90–95", "cell_4": "72–77", "cell_5": "98–103" } },
        { "type": "measure", "settings": { "index": "01", "eyebrow": "Bust", "title": "Across the fullest point.", "text": "Keep the tape level around your chest, without pulling it tight." } }
      ]
    }
  ]
}
{% endschema %}
