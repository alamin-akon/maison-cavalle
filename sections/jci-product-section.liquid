{% comment %}
  Maison Cavallé — product section
  Prototype source: maison-cavalle-main/app.js → renderHome, .product-section markup
                    maison-cavalle-main/styles.css → .product-section, .product-grid,
                    .section-header, .section-cta (lines 184–187, 289–310, 1505–1506, 1535–1542)
  Reference: MAISON-CAVALLE-SPEC.md §1

  A section header, a four-up grid of cards, and a centred link. The cards come
  from snippets/jci-product-card.liquid so the collection template can reuse
  exactly the same card later.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign products = s.collection.products

  # Random order: the list starts from a different product on each render and
  # wraps round, so the cards change between visits instead of always showing
  # the collection's first few. The seed is the render time in seconds.
  if s.random_order and products.size > 1
    assign random_start = 'now' | date: '%s' | modulo: products.size
    assign products_head = products | slice: random_start, products.size
    assign products_tail = products | slice: 0, random_start
    assign products = products_head | concat: products_tail
  endif

  # On a product page the piece being viewed is left out of its own list
  # (app.js:654 — `products.filter((item) => item.id !== product.id)`).
  # Elsewhere there is no current product and nothing is skipped.
  assign current_product_id = product.id
%}

<section
  class="jci-product-section"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="
    --jci-product-section-bg: {{ s.background_color | default: settings.color_palette.background }};
    --jci-product-section-bg-rgb: {{ s.background_color.rgb | default: settings.color_palette.background.rgb }};
    --jci-product-section-heading: {{ s.heading_color | default: settings.color_palette.foreground }};
    --jci-product-section-heading-rgb: {{ s.heading_color.rgb | default: settings.color_palette.foreground.rgb }};
    --jci-product-section-accent: {{ s.accent_color | default: settings.color_palette.color5 }};
    --jci-product-section-intro: {{ s.intro_color }};
    --jci-product-card-subtitle-color: {{ s.subtitle_color }};
    --jci-product-card-media-bg: {{ s.media_background | default: settings.color_palette.color2 }};
    --jci-product-card-ratio: {{ s.image_ratio | divided_by: 100.0 }};
    --jci-product-card-zoom: {{ s.image_zoom | divided_by: 1000.0 | plus: 1 }};
    --jci-product-grid-columns: {{ s.columns }};
    --jci-product-grid-columns-tablet: {{ s.columns_tablet }};
    --jci-product-section-pad-top: {% render 'jci-fluid-space', max: s.padding_top, min: s.padding_top_mobile %};
    --jci-product-section-pad-bottom: {% render 'jci-fluid-space', max: s.padding_bottom, min: s.padding_bottom_mobile %};
    --jci-product-section-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-product-section-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
    --jci-product-grid-columns-mobile: {{ s.columns_mobile }};
    --jci-product-grid-columns-small: {{ s.columns_small }};
    --jci-product-grid-gap: {{ s.grid_gap }}px;
    --jci-product-grid-row-gap-mobile: {{ s.grid_row_gap_mobile }}px;
    --jci-product-section-header-gap: {{ s.header_gap }}px;
  "
>
  <div class="jci-product-section-container">
    {%- if s.eyebrow != blank or s.title_line_one != blank or s.intro != blank -%}
      <div class="jci-product-section-header">
        <div class="jci-product-section-header-copy">
          {%- if s.eyebrow != blank -%}
            <p class="jci-eyebrow jci-product-section-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.title_line_one != blank or s.title_line_two != blank -%}
            <h2 class="jci-product-section-title">
              {{- s.title_line_one -}}
              {%- if s.title_line_one != blank and s.title_line_two != blank -%}{{ ' ' }}{%- endif -%}
              {%- if s.title_line_two != blank -%}
                <em class="jci-product-section-title-accent">{{ s.title_line_two }}</em>
              {%- endif -%}
            </h2>
          {%- endif -%}
        </div>

        {%- if s.intro != blank -%}
          <p class="jci-product-section-intro">{{ s.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    {%- liquid
      assign grid_class = 'jci-product-grid'
      if s.layout == 'slider'
        assign grid_class = 'jci-product-grid jci-product-grid-slider'
      endif
    -%}

    {%- if products.size > 0 -%}
      <div
        class="{{ grid_class }}"
        {% if s.layout == 'slider' %}
          role="region" aria-label="{{ s.title_line_one | append: ' ' | append: s.title_line_two | strip | default: s.eyebrow | escape }}" tabindex="0"
        {% endif %}
      >
        {%- assign shown = 0 -%}
        {%- for product in products -%}
          {%- liquid
            if product.id == current_product_id
              continue
            endif
            if shown >= s.products_to_show
              break
            endif

            assign lazy = true
            if shown < s.columns
              assign lazy = false
            endif
            assign shown = shown | plus: 1
          -%}
          {% render 'jci-product-card',
            product: product,
            section_id: section.id,
            subtitle_key: s.subtitle_metafield,
            badge_text: s.badge_text,
            badge_source: s.badge_source,
            swatch_option: s.swatch_option,
            swatch_metafield: s.swatch_metafield,
            show_quick_add: s.show_quick_add,
            quick_add_label: s.quick_add_label,
            image_index: s.image_index,
            lazy: lazy
          %}
        {%- endfor -%}
      </div>
    {%- else -%}
      {%- comment -%}
        No collection chosen yet. Placeholder cards keep the grid judgeable in
        the Theme Editor rather than collapsing the section to nothing.
      {%- endcomment -%}
      <div class="{{ grid_class }}">
        {%- for i in (1..s.columns) -%}
          <article class="jci-product-card">
            <div class="jci-product-card-media">
              {%- comment -%} Shopify ships product-apparel-1 … -4, so the index wraps. {%- endcomment -%}
              {%- assign placeholder_index = forloop.index0 | modulo: 4 | plus: 1 -%}
              {{ 'product-apparel-' | append: placeholder_index | placeholder_svg_tag: 'jci-product-card-image' }}
            </div>
            <div class="jci-product-card-info">
              <div class="jci-product-card-details">
                <h3 class="jci-product-card-title">{{ 'placeholders.product_title' | t }}</h3>
                <p class="jci-product-card-subtitle">{{ s.placeholder_subtitle }}</p>
              </div>
              <span class="jci-product-card-price">{{ 1990 | money }}</span>
            </div>
          </article>
        {%- endfor -%}
      </div>
    {%- endif -%}

    {%- if s.cta_label != blank -%}
      <div class="jci-product-section-cta">
        <a class="jci-text-link jci-product-section-cta-link" href="{{ s.cta_url | default: routes.all_products_collection_url }}">
          {{ s.cta_label }} {% render 'jci-action-arrow' %}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  .jci-product-section {
    display: block;
    padding-block: var(--jci-product-section-pad-top) var(--jci-product-section-pad-bottom);
    background: var(--jci-product-section-bg);
  }

  /* -- Section header ---------------------------------------------------- */

  .jci-product-section-header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: var(--jci-product-section-header-gap);
  }

  /* The prototype leans on its tight leading for this gap; with normal leading
     (§0) it needs a margin, matching the other home section headers. */
  .jci-product-section-eyebrow {
    margin-bottom: 1rem;
    color: var(--jci-product-section-accent);
  }

  /* One line on desktop; it wraps on its own when the row runs out of room. */
  .jci-product-section-title {
    margin: 0;
    color: var(--jci-product-section-heading);
    font-family: var(--jci-font-display);
    font-size: var(--jci-section-title-size);
    font-weight: 500;
  }

  .jci-product-section-title-accent {
    color: var(--jci-product-section-accent);
    font-style: italic;
  }

  .jci-product-section-intro {
    max-width: 280px;
    margin: 0;
    color: var(--jci-product-section-intro);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  /* -- Grid -------------------------------------------------------------- */

  /* The breakpoints below change only the count and the column gap, so the
     grid and the slider layout both follow them. */
  .jci-product-grid {
    --jci-product-grid-count: var(--jci-product-grid-columns);
    --jci-product-grid-column-gap: var(--jci-product-grid-gap);
    display: grid;
    grid-template-columns: repeat(var(--jci-product-grid-count), minmax(0, 1fr));
    gap: var(--jci-product-grid-gap) var(--jci-product-grid-column-gap);
  }

  /* Slider layout: one row, the same number of cards in view as the grid
     shows per row, swiped or scrolled sideways and snapping card by card. */
  .jci-product-grid-slider {
    grid-template-columns: none;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - (var(--jci-product-grid-count) - 1) * var(--jci-product-grid-column-gap)) /
        var(--jci-product-grid-count)
    );
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x mandatory;
    padding-bottom: 1rem;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--jci-product-section-heading-rgb) / 0.3) transparent;
  }

  .jci-product-grid-slider .jci-product-card {
    scroll-snap-align: start;
  }

  .jci-product-card {
    /* <product-card> is a custom element, so it has no block display of its
       own the way the article it replaced did. */
    display: block;
    min-width: 0;
    transition: transform 0.5s var(--jci-ease);
  }

  /* Lift and shadow are off here; the collection grid turns them on
     (styles.css:483-486) by setting the two custom properties. */
  .jci-product-card:hover {
    transform: translateY(var(--jci-product-card-lift, 0px));
  }

  .jci-product-card-media {
    position: relative;
    margin-bottom: 1rem;
    overflow: hidden;
    aspect-ratio: var(--jci-product-card-ratio);
    background: var(--jci-product-card-media-bg);
    box-shadow: var(--jci-product-card-media-shadow, none);
  }

  .jci-product-card-link {
    display: block;
    width: 100%;
    height: 100%;
  }

  .jci-product-card-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.7s var(--jci-ease);
  }

  .jci-product-card:hover .jci-product-card-image {
    transform: scale(var(--jci-product-card-zoom));
  }

  .jci-product-card-badge {
    position: absolute;
    z-index: 1;
    top: 0.8rem;
    left: 0.8rem;
    padding: 0.4rem 0.55rem;
    color: var(--jci-product-section-bg);
    background: var(--jci-product-section-heading);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

  /* -- Quick add --------------------------------------------------------- */

  .jci-product-card-quick-add {
    position: absolute;
    right: 0.8rem;
    bottom: 0.8rem;
    left: 0.8rem;
    opacity: 0;
    transform: translateY(8px);
    transition:
      opacity 0.3s,
      transform 0.3s var(--jci-ease);
  }

  /* `:focus-within` would also match a mouse click, and the quick-add button
     keeps focus after the modal closes — so its card stayed revealed with the
     pointer nowhere near it, and hovering another showed two at once.
     `:has(:focus-visible)` reveals it for keyboard focus only. */
  .jci-product-card:hover .jci-product-card-quick-add,
  .jci-product-card:has(:focus-visible) .jci-product-card-quick-add {
    opacity: 1;
    transform: translateY(0);
  }

.jci-product-card-quick-add-button {
    display: flex;
    width: 100%;
    min-height: 40px;
    border: 0;
    border-radius: 0;
    color: var(--jci-product-section-heading);
    background: rgb(var(--jci-product-section-bg-rgb) / .94);
    font-family: var(--jci-font-label);
    font-size: 14px;
    text-align: center;
    text-decoration: none;
    text-transform: uppercase;
    cursor: pointer;
    /* text-align: center; */
    align-items: center;
    justify-content: center;
}

  .jci-product-card-quick-add-icon {
    display: none;
    fill: none;
    stroke: currentcolor;
    stroke-width: 1.5;
  }

  /* Horizon's add-to-cart button carries `.button`'s box (24px/16px padding)
     and the checkmark burst. The box is reset to the prototype's slim bar and
     the burst is sized to it. Reached only inside our own scope, per §1. */
  .jci-product-card-quick-add .jci-product-card-quick-add-button {
    padding: 0;
    box-shadow: none;
  }

  .jci-product-card-quick-add .add-to-cart__added-icon {
    width: 22px;
    height: 22px;
  }

  /* The component wrappers are plumbing; they must not form a box of their
     own or the button stops filling the bar. */
  .jci-product-card-quick-add-component,
  .jci-product-card-form {
    display: block;
  }

  .jci-product-card-live-region {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* -- Info row ---------------------------------------------------------- */

  .jci-product-card-info {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.8rem;
  }

  .jci-product-card-details {
    min-width: 0;
  }

  .jci-product-card-title {
    min-height: 2.3em;
    margin: 0;
    font-family: var(--jci-font-display);
    font-size: 16px;
    font-weight: 400;
  }

  .jci-product-card-title-link {
    color: inherit;
    text-decoration: none;
  }

  .jci-product-card-subtitle {
    min-height: 2.7em;
    margin: 0.35rem 0 0;
    color: var(--jci-product-card-subtitle-color);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  .jci-product-card-price {
    font-family: var(--jci-font-label);
    font-size: 14px;
    white-space: nowrap;
  }

  .jci-product-card-price-was {
    margin-left: 0.4rem;
    opacity: 0.55;
  }

  .jci-product-card-swatches {
    display: flex;
    gap: 0.35rem;
    margin-top: 0.6rem;
  }

  .jci-product-card-swatch {
    width: 10px;
    height: 10px;
    border: 1px solid rgb(var(--jci-product-section-heading-rgb) / 0.25);
    border-radius: 50%;
    background: var(--jci-product-card-swatch-color);
  }

  /* -- Footer link ------------------------------------------------------- */

  .jci-product-section-cta {
    display: flex;
    justify-content: center;
    margin-top: 3.7rem;
  }

  /* -- Breakpoints (§5 — 900 and 680, plus 1200 for the grid by developer
     instruction) ------------------------------------------------------- */

  /* Four cards are too narrow below 1200px, so the grid drops to the tablet
     count until the 680px mobile count takes over. */
  @media screen and (max-width: 1200px) {
    .jci-product-grid {
      --jci-product-grid-count: var(--jci-product-grid-columns-tablet);
    }
  }

  @media screen and (max-width: 900px) {
    .jci-product-section-header {
      display: block;
      margin-bottom: 1.8rem;
    }

    /* On the intro rather than under the title: Horizon's base.css zeroes the
       bottom margin of a heading that is its parent's last child. */
    .jci-product-section-intro {
      max-width: none;
      margin-top: 1rem;
    }
  }

  @media screen and (max-width: 680px) {
    .jci-product-section {
      padding-block: var(--jci-product-section-pad-top-mobile) var(--jci-product-section-pad-bottom-mobile);
    }
.jci-product-section-title{
  font-size: 11vw;
}
    .jci-product-grid {
      --jci-product-grid-count: var(--jci-product-grid-columns-mobile);
      /* styles.css:@680 — `gap: 2.3rem .7rem`. The column gap tightens on
         mobile rather than carrying the desktop grid gap across. */
      --jci-product-grid-column-gap: 0.7rem;
      row-gap: var(--jci-product-grid-row-gap-mobile);
    }

    /* Hover cannot reveal the button on touch, so the desktop "Quick add" bar
       stays on show at the foot of the image. No icon-only square on mobile
       (developer instruction). */
    .jci-product-card-quick-add {
      opacity: 1;
      transform: none;
    }

    .jci-product-card-info {
      display: block;
    }

    /* The reserved heights only line up the title and price row across a
       desktop row. Stacked, they read as empty gaps under a one-line title
       or subtitle. */
    .jci-product-card-title {
      min-height: 0;
      font-size: 15px;
    }

    .jci-product-card-subtitle {
      min-height: 0;
    }

    .jci-product-card-price {
      display: block;
      margin-top: 0.5rem;
    }
  }

  /* Developer instruction: one card per row on the smallest phones. */
  @media screen and (max-width: 430px) {
    .jci-product-grid {
      --jci-product-grid-count: var(--jci-product-grid-columns-small);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-product-card,
    .jci-product-card-image,
    .jci-product-card-quick-add {
      transition: none;
    }

    .jci-product-card:hover {
      transform: none;
    }

    .jci-product-card:hover .jci-product-card-image {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product section",
  "tag": "div",
  "class": "jci-product-section-wrapper",
  "settings": [
    { "type": "header", "content": "Header" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The opening collection" },
    { "type": "text", "id": "title_line_one", "label": "Title", "default": "Pieces to come" },
    { "type": "text", "id": "title_line_two", "label": "Title accent (italic)", "default": "back to." },
    { "type": "textarea", "id": "intro", "label": "Intro", "default": "Fewer, better pieces — made to be worn season after season." },

    { "type": "header", "content": "Products" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "checkbox", "id": "random_order", "label": "Show products in random order", "default": false, "info": "Starts from a different product in the collection on each visit." },
    { "type": "select", "id": "layout", "label": "Layout", "options": [{ "value": "grid", "label": "Grid" }, { "value": "slider", "label": "Slider" }], "default": "grid", "info": "Slider keeps every product on one row, with the column counts below in view." },
    { "type": "range", "id": "products_to_show", "label": "Products to show", "min": 2, "max": 12, "step": 1, "default": 4 },
    { "type": "range", "id": "columns", "label": "Columns on desktop", "min": 2, "max": 5, "step": 1, "default": 4 },
    { "type": "range", "id": "columns_tablet", "label": "Columns below 1200px", "min": 1, "max": 4, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_mobile", "label": "Columns on mobile", "min": 1, "max": 3, "step": 1, "default": 2 },
    { "type": "range", "id": "columns_small", "label": "Columns below 430px", "min": 1, "max": 3, "step": 1, "default": 1 },
    { "type": "range", "id": "image_index", "label": "Image to show", "min": 0, "max": 5, "step": 1, "default": 0, "info": "0 is the first product image." },

    { "type": "header", "content": "Card details" },
    { "type": "text", "id": "subtitle_metafield", "label": "Subtitle metafield", "default": "custom.subtitle", "info": "namespace.key — falls back to the product type when empty." },
    { "type": "text", "id": "swatch_option", "label": "Swatch option name", "default": "Color", "info": "Reads colour swatches from this product option." },
    { "type": "text", "id": "swatch_metafield", "label": "Swatch colour metafield", "default": "custom.colour_swatches", "info": "Fallback for option values with no Shopify swatch. Holds \"Name:#hex | Name:#hex\" pairs." },
    { "type": "checkbox", "id": "show_quick_add", "label": "Show quick add", "default": true, "info": "Single-variant products add straight to cart; the rest link to the product page." },
    { "type": "text", "id": "quick_add_label", "label": "Quick add label", "default": "Quick add" },

    { "type": "header", "content": "Badge" },
    {
      "type": "select", "id": "badge_source", "label": "Show badge",
      "options": [
        { "value": "none", "label": "Never" },
        { "value": "sale", "label": "Only when on sale" },
        { "value": "always", "label": "On every card" }
      ],
      "default": "sale"
    },
    { "type": "text", "id": "badge_text", "label": "Badge text", "default": "Sale" },

    { "type": "header", "content": "Footer link" },
    { "type": "text", "id": "cta_label", "label": "Label", "default": "View all pieces" },
    { "type": "url", "id": "cta_url", "label": "Link" },

    { "type": "header", "content": "Colors", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "heading_color", "label": "Heading" },
    { "type": "color", "id": "accent_color", "label": "Accent" },
    { "type": "color", "id": "media_background", "label": "Image placeholder" },
    { "type": "color", "id": "intro_color", "label": "Intro text", "default": "#5f6259" },
    { "type": "color", "id": "subtitle_color", "label": "Card subtitle", "default": "#6d7066" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "header_gap", "label": "Space under the header", "min": 0, "max": 120, "step": 2, "unit": "px", "default": 40 },
