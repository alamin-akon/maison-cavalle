{% comment %}
  Maison Cavallé — review carousel

  Design source: sections/jci-testimonials.liquid, itself cloned from
                 maison-cavalle-main/styles.css → .testimonials-* / .testimonial-card-*
  Reference: MAISON-CAVALLE-SPEC.md §0, §1, §3, §5, §7

  The live counterpart to the static testimonials section: the same cream band,
  header and quote cards, filled by the Junip review carousel app block placed
  inside it. Junip renders into the page (not an iframe), scrolls its own track
  with native scroll-snap, and sets its colours as --junip* custom properties on
  :root, so this section redefines those for its scope and restyles Junip's
  markup to the testimonial card. JS and behaviour stay Junip's.

  Junip's classes are third-party and not ours to rename, so they are reached
  only through .jci-review-carousel (§1). Junip gives the cards no tone hook,
  so the featured and soft tones follow the testimonials rhythm by position -
  the one place structural selectors stand in for classes we cannot add.

  In each card Junip's product line moves up into the testimonial topline,
  the review title is dropped (the quote is the card, as on the static
  testimonials) and the reviewer's name becomes the ruled footer.

  No letter-spacing or line-height is authored (§0).
{% endcomment %}

{%- assign s = section.settings -%}

<section
  class="jci-review-carousel"
  data-jci-review-carousel
  {% if s.anchor_id != blank %}id="{{ s.anchor_id | handleize }}"{% endif %}
  style="
    --jci-review-carousel-bg: {{ s.background_color | default: settings.color_palette.color3 }};
    --jci-review-carousel-text: {{ s.text_color | default: settings.color_palette.foreground }};
    --jci-review-carousel-text-rgb: {{ s.text_color.rgb | default: settings.color_palette.foreground.rgb }};
    --jci-review-carousel-eyebrow: {{ s.eyebrow_color | default: settings.color_palette.color5 }};
    --jci-review-carousel-accent: {{ s.accent_color | default: settings.color_palette.color5 }};
    --jci-review-carousel-intro: {{ s.intro_color | default: settings.color_palette.color1 }};
    --jci-review-carousel-card-bg: {{ s.card_background | default: settings.color_palette.background }};
    --jci-review-carousel-soft-bg: {{ s.soft_background | default: settings.color_palette.color2 }};
    --jci-review-carousel-stars: {{ s.stars_color | default: settings.color_palette.color6 }};
    --jci-review-carousel-featured-bg: {{ s.featured_background | default: settings.color_palette.color5 }};
    --jci-review-carousel-featured-text: {{ s.featured_text_color | default: settings.color_palette.background }};
    --jci-review-carousel-featured-text-rgb: {{ s.featured_text_color.rgb | default: settings.color_palette.background.rgb }};
    --jci-review-carousel-card-gap: clamp({{ s.card_gap | times: 0.5 | round }}px, 1.7vw, {{ s.card_gap }}px);
    --jci-review-carousel-card-min-height: clamp({{ s.card_min_height | times: 0.767 | round }}px, 30vw, {{ s.card_min_height }}px);
    --jci-review-carousel-pad-top: {% render 'jci-fluid-space', max: s.padding_top, min: s.padding_top_mobile %};
    --jci-review-carousel-pad-bottom: {% render 'jci-fluid-space', max: s.padding_bottom, min: s.padding_bottom_mobile %};
    --jci-review-carousel-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-review-carousel-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
  {{ section.shopify_attributes }}
>
  <div class="jci-review-carousel-container">
    {%- if s.eyebrow != blank or s.heading != blank or s.intro != blank -%}
      <div class="jci-review-carousel-header">
        <div class="jci-review-carousel-headline">
          {%- if s.eyebrow != blank -%}
            <p class="jci-eyebrow jci-review-carousel-eyebrow">{{ s.eyebrow }}</p>
          {%- endif -%}

          {%- if s.heading != blank -%}
            <h2 class="jci-review-carousel-title">
              {{ s.heading }}
              {%- if s.heading_accent != blank -%}
                {{ ' ' }}<em class="jci-review-carousel-title-accent">{{ s.heading_accent }}</em>
              {%- endif -%}
            </h2>
          {%- endif -%}
        </div>

        {%- if s.intro != blank -%}
          <p class="jci-review-carousel-intro">{{ s.intro }}</p>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="jci-review-carousel-app">
      {%- for block in section.blocks -%}
        {% render block %}
      {%- endfor -%}
    </div>
  </div>
</section>

<script src="{{ 'jci-review-carousel.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  /* The testimonials band, with Junip's colours for this scope. */
  .jci-review-carousel {
    --junipPrimaryColor: var(--jci-review-carousel-stars);
    --junipStarColor: var(--jci-review-carousel-stars);
    --junipButtonColor: var(--jci-review-carousel-text);
    --junipButtonTextColor: var(--jci-review-carousel-card-bg);
    --junipBorderColor: rgb(var(--jci-review-carousel-text-rgb) / 0.18);

    position: relative;
    display: block;
    overflow: hidden;
    padding-block: var(--jci-review-carousel-pad-top) var(--jci-review-carousel-pad-bottom);
    color: var(--jci-review-carousel-text);
    background: var(--jci-review-carousel-bg);
  }

  .jci-review-carousel-container {
    position: relative;
    z-index: 1;
  }

  /* -- Header (jci-testimonials) ----------------------------------------- */

  .jci-review-carousel-header {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(250px, 0.65fr);
    align-items: end;
    gap: clamp(2rem, 8vw, 8rem);
    margin-block-end: clamp(2.5rem, 5vw, 4.5rem);
  }

  .jci-review-carousel-eyebrow {
    margin-block-end: 0.9rem;
    color: var(--jci-review-carousel-eyebrow);
  }

  .jci-review-carousel-title {
    max-width: 620px;
    margin: 0;
    font-family: var(--jci-font-display);
    font-size: var(--jci-section-title-size);
    font-weight: 500;
  }

  .jci-review-carousel-title-accent {
    color: var(--jci-review-carousel-accent);
    font-style: italic;
  }

  .jci-review-carousel-intro {
    justify-self: end;
    max-width: 360px;
    margin: 0;
    color: var(--jci-review-carousel-intro);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  /* -- Junip widget ------------------------------------------------------ */

  /* The block's own padding settings are inline; the section owns spacing. */
  .jci-review-carousel .junip-review-carousel {
    padding: 0 !important;
    font-family: var(--jci-font-sans);
  }

  .jci-review-carousel .junip-px-4 {
    padding-inline: 0;
  }

  /* Rating summary as a label row above the rail. The section heading
     replaces Junip's own title. */
  .jci-review-carousel .junip-review-carousel-title {
    display: none;
  }

  .jci-review-carousel .junip-review-carousel-summary {
    align-items: flex-start;
    margin-bottom: 1.4rem;
  }

  .jci-review-carousel .junip-review-carousel-summary-stats {
    gap: 0.5rem;
    color: var(--jci-review-carousel-eyebrow);
    font-family: var(--jci-font-label);
    font-size: 12px;
    text-transform: uppercase;
  }

.jci-review-carousel .junip-review-carousel-summary-rating, .jci-review-carousel .junip-review-carousel-summary-review-count {
    font-size: clamp(1.2rem,1.7vw,1.65rem);
    font-weight: 500;
    font-style: italic;
}

  /* The rail: cards start flush left and leave room for their offset shadow. */
  .jci-review-carousel .junip-review-carousel-container {
    gap: var(--jci-review-carousel-card-gap);
    align-items: stretch;
    margin: 0;
    padding: 0.5rem 14px 18px 0;
    cursor: grab;
    user-select: none;
  }

  /* jci-review-carousel.js: the track follows the mouse with snapping and
     smooth scrolling suspended, then settles on a card. */
  .jci-review-carousel .junip-review-carousel-container.is-dragging {
    cursor: grabbing;
    scroll-behavior: auto;
    scroll-snap-type: none;
  }

  .jci-review-carousel .junip-review-carousel-item {
    position: relative;
    isolation: isolate;
    align-items: stretch;
    width: clamp(280px, 27vw, 460px);
    height: auto;
    min-height: var(--jci-review-carousel-card-min-height);
    padding: clamp(1.2rem, 2.2vw, 2rem);
    border: 1px solid rgb(var(--jci-review-carousel-text-rgb) / 0.18);
    border-radius: 0;
    color: var(--jci-review-carousel-text);
    background: var(--jci-review-carousel-card-bg);
    box-shadow: 9px 10px 0 rgb(var(--jci-review-carousel-text-rgb) / 0.07);
    text-align: left;
    scroll-snap-align: start;
    scroll-snap-stop: always;
    transition: transform 0.5s var(--jci-ease), box-shadow 0.5s var(--jci-ease);
  }

  .jci-review-carousel .junip-review-carousel-item.junip-review-carousel-item-clickable:hover {
    transform: translateY(-7px);
    box-shadow: 13px 16px 0 rgb(var(--jci-review-carousel-text-rgb) / 0.1);
  }

  /* No focus outline on the cards, Junip's own :focus ring included. */
  .jci-review-carousel .junip-review-carousel-item.junip-review-carousel-item-clickable:focus,
  .jci-review-carousel .junip-review-carousel-item.junip-review-carousel-item-clickable:focus-visible {
    outline: none;
  }

  /* The testimonial card's opening quote mark. */
  .jci-review-carousel .junip-review-carousel-item::before {
    content: '\201C';
    position: absolute;
    top: 0.8rem;
    right: 1.1rem;
    z-index: -1;
    color: rgb(var(--jci-olive-rgb) / 0.18);
    font-family: var(--jci-font-display);
    font-size: 100px;
  }

  /* Featured first, then default and soft in turn - the testimonials rhythm. */
  .jci-review-carousel .junip-review-carousel-item:first-child {
    width: clamp(320px, 31vw, 520px);
    border-color: var(--jci-review-carousel-featured-bg);
    color: var(--jci-review-carousel-featured-text);
    background: var(--jci-review-carousel-featured-bg);
  }

  .jci-review-carousel .junip-review-carousel-item:first-child::before {
    color: rgb(var(--jci-review-carousel-featured-text-rgb) / 0.2);
  }

  .jci-review-carousel .junip-review-carousel-item:nth-child(odd):not(:first-child) {
    background: var(--jci-review-carousel-soft-bg);
  }

  /* Topline: Junip's "Review for <product>", product name only. */
  .jci-review-carousel .junip-review-product {
    order: -1;
    margin: 0;
    padding-right: 3rem;
    color: var(--jci-review-carousel-eyebrow);
    font-family: var(--jci-font-label);
    font-size: 0;
    text-transform: uppercase;
  }

  .jci-review-carousel .junip-review-product a {
    font-size: 12px;
    text-decoration: none;
  }

  .jci-review-carousel .junip-review-carousel-item:first-child .junip-review-product {
    color: rgb(var(--jci-review-carousel-featured-text-rgb) / 0.85);
  }

  /* Stars sit low, above the quote. */
  .jci-review-carousel .junip-review-carousel-item .junip-star-ratings-container {
    margin: auto 0 1.25rem;
  }

  .jci-review-carousel .junip-review-carousel-item .junip-stars-filled,
  .jci-review-carousel .junip-review-carousel-item .junip-stars-outline {
    gap: 2px;
  }

  .jci-review-carousel .junip-review-carousel-item .junip-star-ratings-container .junip-star {
    width: 14px;
    height: 14px;
    padding: 0;
  }

  .jci-review-carousel .junip-review-carousel-item:first-child .junip-star-ratings-container {
    --junipStarColor: rgb(var(--jci-review-carousel-featured-text-rgb) / 0.9);
  }

  .jci-review-carousel .junip-review-carousel-item-title {
    display: none;
  }

  /* The quote. */
  .jci-review-carousel .junip-review-carousel-item .junip-review-body {
    max-width: 490px;
    margin: 0;
    font-family: var(--jci-font-display);
    font-size: clamp(1.25rem, 1.8vw, 1.85rem);
    font-weight: 500;
  }

  .jci-review-carousel .junip-review-carousel-item:first-child .junip-review-body {
    font-size: clamp(1.45rem, 2.4vw, 2.45rem);
  }

  /* The card is the quote alone; review photos stay in Junip's popup. */
  .jci-review-carousel .junip-review-carousel-item .junip-review-carousel-media-container {
    display: none;
  }

  /* Footer: the reviewer, ruled off like the testimonial attribution. */
  .jci-review-carousel .junip-review-carousel-item-customer {
    width: 100%;
    margin: 2rem 0 0;
    padding-top: 1rem;
    border-top: 1px solid rgb(var(--jci-review-carousel-text-rgb) / 0.16);
    font-family: var(--jci-font-label);
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
  }

  .jci-review-carousel .junip-review-carousel-item:first-child .junip-review-carousel-item-customer {
    border-color: rgb(var(--jci-review-carousel-featured-text-rgb) / 0.26);
  }

  /* No arrows: the rail scrolls by swipe, trackpad or scroll wheel. */
  .jci-review-carousel .junip-review-carousel-arrow {
    display: none;
  }

  .jci-review-carousel .junip-powered-by-footer {
    margin-top: 1.5rem;
  }

  /* -- Breakpoints (§5 — 900 and 680 only) ------------------------------- */

  @media screen and (max-width: 680px) {
    .jci-review-carousel {
      padding-block: var(--jci-review-carousel-pad-top-mobile) var(--jci-review-carousel-pad-bottom-mobile);
    }

  .jci-review-carousel-title {
    font-size: 11vw;
    width: 368px;
}

    .jci-review-carousel-header {
      display: block;
      margin-block-end: 2.5rem;
    }

    .jci-review-carousel-intro {
      justify-self: start;
      max-width: 320px;
      margin-block-start: 1.7rem;
    }

    .jci-review-carousel .junip-review-carousel-container {
      gap: 0.8rem;
    }

    .jci-review-carousel .junip-review-carousel-item,
    .jci-review-carousel .junip-review-carousel-item:first-child {
      width: 100%;
      min-height: 330px;
    }

    .jci-review-carousel .junip-review-carousel-item .junip-review-body,
    .jci-review-carousel .junip-review-carousel-item:first-child .junip-review-body {
      font-size: clamp(1.45rem, 7vw, 2rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-review-carousel .junip-review-carousel-item {
      transition: none;
    }

    .jci-review-carousel .junip-review-carousel-item.junip-review-carousel-item-clickable:hover {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review carousel",
  "tag": "div",
  "class": "jci-review-carousel-wrapper",
  "blocks": [{ "type": "@app" }],
  "settings": [
    { "type": "paragraph", "content": "Add the Junip review carousel app block to this section. Clear the block's title; this section's heading replaces it." },

    { "type": "header", "content": "Header", "info": "Leave all three empty to show the carousel on its own." },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Verified reviews" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "In their" },
    { "type": "text", "id": "heading_accent", "label": "Heading accent", "default": "own words.", "info": "Shown in italics in the accent colour." },
    { "type": "text", "id": "intro", "label": "Intro", "default": "Notes from riders who wear the Maison at the stable and beyond." },

    { "type": "header", "content": "Colours", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "eyebrow_color", "label": "Eyebrow and card topline" },
    { "type": "color", "id": "accent_color", "label": "Heading accent" },
    { "type": "color", "id": "intro_color", "label": "Intro" },
    { "type": "color", "id": "card_background", "label": "Card background" },
    { "type": "color", "id": "soft_background", "label": "Soft card background" },
    { "type": "color", "id": "stars_color", "label": "Stars" },
    { "type": "color", "id": "featured_background", "label": "Featured card background" },
    { "type": "color", "id": "featured_text_color", "label": "Featured card text" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "card_gap", "label": "Card gap", "min": 8, "max": 64, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "card_min_height", "label": "Card minimum height", "min": 260, "max": 620, "step": 10, "unit": "px", "default": 430 },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Anchor" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "reviews" }
  ],
  "presets": [{ "name": "Review carousel" }]
}
{% endschema %}
