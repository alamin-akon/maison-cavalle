{% comment %}
  Maison Cavallé — hero
  Prototype source: maison-cavalle-main/hero.js (markup + slide data)
                    maison-cavalle-main/app.js → setupHeroVideoSequence, activateMotion
                    maison-cavalle-main/styles.css → .home-hero and friends
  Reference: MAISON-CAVALLE-SPEC.md §1

  Three "moments" crossfade behind the copy. Each is a block, so moments can be
  added, reordered or removed from the Theme Editor.

  Videos come from Shopify Files through the video picker, not the theme's
  assets folder — the prototype's three clips are 47 MB together, far past what
  a theme can carry. See SPEC §2.
{% endcomment %}

{% liquid
  assign s = section.settings
  assign moments = section.blocks | where: 'type', 'moment'
  assign total = moments.size
%}

<dev-hero
  class="dev-hero"
  data-dev-hero
  {% if s.enable_pointer_depth %}data-dev-pointer-depth{% endif %}
  {% if s.enable_scroll_depth %}data-dev-scroll-depth{% endif %}
  {% if s.autoplay %}data-dev-autoplay{% endif %}
  style="
    --dev-hero-min-height: {{ s.min_height }}px;
    --dev-hero-min-height-mobile: {{ s.min_height_mobile }}px;
    --dev-hero-offset: {{ s.viewport_offset }}px;
    --dev-hero-text: {{ s.text_color }};
    --dev-hero-accent: {{ s.accent_color }};
    --dev-hero-meta: {{ s.meta_color }};
    --dev-hero-fallback-bg: {{ s.fallback_background }};
    --dev-hero-scrim-side: {{ s.scrim_side | divided_by: 100.0 }};
    --dev-hero-scrim-bottom: {{ s.scrim_bottom | divided_by: 100.0 }};
    --dev-hero-video-saturate: {{ s.video_saturate | divided_by: 100.0 }};
    --dev-hero-video-contrast: {{ s.video_contrast | divided_by: 100.0 }};
    --dev-hero-video-brightness: {{ s.video_brightness | divided_by: 100.0 }};
    --dev-hero-grain-opacity: {{ s.grain_opacity | divided_by: 100.0 }};
    --dev-hero-title-size: clamp({{ s.title_size_min }}rem, {{ s.title_size_fluid | divided_by: 10.0 }}vw, {{ s.title_size_max }}rem);
    --dev-hero-title-leading: {{ s.title_leading | divided_by: 100.0 }};
    --dev-hero-title-tracking: -{{ s.title_tracking | divided_by: 100.0 }}em;
    --dev-hero-crossfade: {{ s.crossfade_duration }}ms;
  "
>
  <div class="dev-hero-media" data-dev-hero-media aria-hidden="true">
    {%- for block in moments -%}
      {%- assign video = block.settings.video -%}
      {%- assign video_asset = block.settings.video_asset | strip -%}
      {%- assign poster = block.settings.poster | default: video.preview_image -%}
      {%- assign poster_asset = block.settings.poster_asset | strip -%}
      {%- if poster_asset != blank -%}
        {%- assign poster_src = poster_asset | asset_url -%}
      {%- elsif poster != blank -%}
        {%- assign poster_src = poster | image_url: width: 1800 -%}
      {%- else -%}
        {%- assign poster_src = blank -%}
      {%- endif -%}
      {%- if video_asset != blank or video != blank -%}
        <video
          class="dev-hero-video{% if forloop.first %} is-active{% endif %}"
          data-dev-hero-video
          data-dev-hero-video-index="{{ forloop.index0 }}"
          muted
          playsinline
          preload="{% if forloop.first %}auto{% else %}metadata{% endif %}"
          {% if poster_src != blank %}poster="{{ poster_src }}"{% endif %}
        >
          {%- comment -%}
            A filename in the theme's assets folder wins, so the clip travels
            with the theme code. An upload in Files is the fallback.
          {%- endcomment -%}
          {%- if video_asset != blank -%}
            <source src="{{ video_asset | asset_url }}" type="video/mp4">
          {%- else -%}
            {%- for source in video.sources -%}
              {%- if source.format == 'mp4' -%}
                <source src="{{ source.url }}" type="{{ source.mime_type }}">
              {%- endif -%}
            {%- endfor -%}
          {%- endif -%}
        </video>
      {%- elsif poster_src != blank -%}
        {%- comment -%} No video yet — show the still so the layout is judgeable. {%- endcomment -%}
        <img
          class="dev-hero-video{% if forloop.first %} is-active{% endif %}"
          data-dev-hero-video
          data-dev-hero-video-index="{{ forloop.index0 }}"
          src="{{ poster_src }}"
          alt=""
          width="{{ poster.width | default: 1800 }}"
          height="{{ poster.height | default: 1013 }}"
          loading="eager"
        >
      {%- endif -%}
    {%- endfor -%}
    <span class="dev-hero-grain"></span>
  </div>

  <div class="dev-hero-container">
    <div class="dev-hero-topline">
      {%- if s.topline_left != blank -%}
        <p class="dev-eyebrow dev-hero-topline-eyebrow">{{ s.topline_left }}</p>
      {%- endif -%}
      {%- if s.topline_right != blank -%}
        <span class="dev-hero-topline-note">{{ s.topline_right }}</span>
      {%- endif -%}
    </div>

    <div class="dev-hero-grid">
      <div
        class="dev-hero-copy"
        id="dev-hero-panel"
        data-dev-hero-panel
        role="tabpanel"
        aria-live="polite"
      >
        {%- for block in moments -%}
          {%- if forloop.first -%}
            {%- assign b = block.settings -%}
            {%- if b.eyebrow != blank -%}
              <p class="dev-eyebrow dev-hero-copy-eyebrow" data-dev-hero-eyebrow>{{ b.eyebrow }}</p>
            {%- endif -%}

            <h1 class="dev-hero-title" id="dev-hero-title" data-dev-hero-title>
              {%- assign words = b.title | strip | split: ' ' -%}
              {%- for word in words -%}
                <span
                  class="dev-hero-title-word"
                  {% if forloop.index0 >= b.accent_from %}data-dev-hero-accent="true"{% endif %}
                  style="--dev-word-index: {{ forloop.index0 }}"
                >{{ word }}</span>
              {%- endfor -%}
            </h1>

            {%- if b.copy != blank -%}
              <p class="dev-hero-text" data-dev-hero-copy>{{ b.copy }}</p>
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}

        {%- if s.cta_label != blank -%}
          <a class="dev-button dev-button--light dev-hero-cta" href="{{ s.cta_link | default: routes.all_products_collection_url }}">
            {{ s.cta_label }} <span aria-hidden="true">&#8599;</span>
          </a>
        {%- endif -%}
      </div>

      {%- if s.show_side_note -%}
        <div class="dev-hero-side-note">
          <span class="dev-hero-side-note-dot" aria-hidden="true"></span>
          <span data-dev-hero-descriptor>{{ moments.first.settings.descriptor }}</span>
        </div>
      {%- endif -%}
    </div>

    {%- if s.show_fit_card and s.fit_card_title != blank -%}
      <a class="dev-hero-fit-card" href="{{ s.fit_card_link }}">
        {%- if s.fit_card_kicker != blank -%}
          <span class="dev-hero-fit-card-kicker">{{ s.fit_card_kicker }}</span>
        {%- endif -%}
        <strong class="dev-hero-fit-card-title">{{ s.fit_card_title }}</strong>
        {%- if s.fit_card_link_label != blank -%}
          <span class="dev-hero-fit-card-link">
            {{ s.fit_card_link_label }} <b aria-hidden="true">&#8599;</b>
          </span>
        {%- endif -%}
      </a>
    {%- endif -%}

    <div class="dev-hero-bottomline">
      {%- if s.scroll_label != blank -%}
        <div class="dev-hero-scroll">
          {{ s.scroll_label }} <span aria-hidden="true">&#8595;</span>
        </div>
      {%- endif -%}

      {%- if total > 1 -%}
        <div class="dev-hero-moment-nav" role="tablist" aria-label="{{ s.tablist_label }}">
          {%- for block in moments -%}
            <button
              class="dev-hero-moment{% if forloop.first %} is-active{% endif %}"
              type="button"
              role="tab"
              data-dev-hero-slide="{{ forloop.index0 }}"
              aria-selected="{% if forloop.first %}true{% else %}false{% endif %}"
              aria-controls="dev-hero-panel"
              tabindex="{% if forloop.first %}0{% else %}-1{% endif %}"
              {{ block.shopify_attributes }}
            >
              <span class="dev-hero-moment-number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
              <span class="dev-hero-moment-label">{{ block.settings.label }}</span>
              <span class="dev-hero-moment-line" aria-hidden="true"><i></i></span>
            </button>
          {%- endfor -%}
        </div>

        <div class="dev-hero-index">
          <span data-dev-hero-index>01</span>
          <i aria-hidden="true"></i>
          <span>{{ total | prepend: '0' | slice: -2, 2 }}</span>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} Slide copy for the moments the JS swaps in. {%- endcomment -%}
  <script type="application/json" data-dev-hero-moments>
    [
      {%- for block in moments -%}
        {
          "eyebrow": {{ block.settings.eyebrow | json }},
          "title": {{ block.settings.title | json }},
          "accentFrom": {{ block.settings.accent_from | json }},
          "copy": {{ block.settings.copy | json }},
          "descriptor": {{ block.settings.descriptor | json }}
        }{%- unless forloop.last -%},{%- endunless -%}
      {%- endfor -%}
    ]
  </script>
</dev-hero>

<script src="{{ 'dev-hero.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .dev-hero {
    position: relative;
    display: block;
    min-height: max(var(--dev-hero-min-height), calc(100svh - var(--dev-hero-offset)));
    overflow: hidden;
    isolation: isolate;
    color: var(--dev-hero-text);
    background: var(--dev-hero-fallback-bg);
  }

  /* Two scrims: one across, one up from the base, so the copy stays legible. */
  .dev-hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
        90deg,
        rgb(17 21 17 / var(--dev-hero-scrim-side)),
        rgb(17 21 17 / calc(var(--dev-hero-scrim-side) * 0.26)) 68%,
        rgb(17 21 17 / calc(var(--dev-hero-scrim-side) * 0.16))
      ),
      linear-gradient(0deg, rgb(17 21 17 / var(--dev-hero-scrim-bottom)), transparent 52%);
    pointer-events: none;
  }

  .dev-hero-media {
    position: absolute;
    inset: -2%;
    z-index: -2;
    background: var(--dev-hero-fallback-bg);
    transform: translate3d(
        var(--dev-hero-shift-x, 0px),
        calc(var(--dev-hero-shift-y, 0px) + var(--dev-hero-scroll-y, 0px)),
        0
      )
      scale(1.03);
    transition: transform 0.45s var(--dev-ease);
    will-change: transform;
  }

  .dev-hero-video {
    display: block;
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0;
    filter: saturate(var(--dev-hero-video-saturate)) contrast(var(--dev-hero-video-contrast))
      brightness(var(--dev-hero-video-brightness));
    transition: opacity var(--dev-hero-crossfade) var(--dev-ease);
  }

  .dev-hero-video.is-active {
    opacity: 1;
  }

  .dev-hero-grain {
    position: absolute;
    inset: 0;
    opacity: var(--dev-hero-grain-opacity);
    background-image: radial-gradient(rgb(251 250 247 / 0.4) 0.5px, transparent 0.7px);
    background-size: 4px 4px;
    mix-blend-mode: soft-light;
    pointer-events: none;
  }

  .dev-hero-container {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    min-height: max(var(--dev-hero-min-height), calc(100svh - var(--dev-hero-offset)));
    padding-block: clamp(1.4rem, 3vw, 3rem) clamp(1.3rem, 2.8vw, 2.7rem);
  }

  /* --- Top rule --- */
  .dev-hero-topline {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block-end: 1.15rem;
    border-block-end: 1px solid rgb(251 250 247 / 0.3);
    color: var(--dev-hero-meta);
  }

  .dev-hero-topline-eyebrow {
    color: var(--dev-hero-meta);
  }

  .dev-hero-topline-note {
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  /* --- Copy --- */
  .dev-hero-grid {
    flex: 1;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(180px, 0.34fr);
    gap: clamp(2rem, 8vw, 9rem);
    align-items: end;
    padding-block: clamp(4.5rem, 8vw, 8rem) clamp(3rem, 5vw, 5rem);
  }

  .dev-hero-copy {
    max-width: 740px;
  }

  .dev-hero-copy > * {
    transition: opacity 0.4s var(--dev-ease), transform 0.4s var(--dev-ease);
  }

  .dev-hero-copy.is-changing > * {
    opacity: 0;
    transform: translateY(0.65rem);
  }

  .dev-hero-copy-eyebrow {
    margin-block-end: 1.35rem;
    color: var(--dev-hero-meta);
  }

  .dev-hero-title {
    max-width: 740px;
    margin: 0 0 1.65rem;
    font-family: var(--dev-font-display);
    font-size: var(--dev-hero-title-size);
    font-weight: 500;
    line-height: var(--dev-hero-title-leading);
    letter-spacing: var(--dev-hero-title-tracking);
    text-wrap: balance;
  }

  /* Each word lifts in, staggered by its index. */
  .dev-hero-title-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(0.32em) rotate(1.5deg);
    animation: dev-hero-word-in 0.75s calc(var(--dev-word-index) * 45ms) var(--dev-ease) both;
  }

  .dev-hero-title-word[data-dev-hero-accent='true'] {
    color: var(--dev-hero-accent);
    font-style: italic;
  }

  .dev-hero-text {
    max-width: 405px;
    margin: 0 0 2.1rem;
    color: var(--dev-hero-meta);
    font-family: var(--dev-font-sans);
    font-size: var(--dev-subtitle-size);
    line-height: var(--dev-subtitle-leading);
  }

  .dev-hero-cta {
    min-width: 205px;
    transition: color 0.3s, background 0.3s, border-color 0.3s, box-shadow 0.35s var(--dev-ease),
      transform 0.35s var(--dev-ease);
  }

  .dev-hero-cta span {
    transition: transform 0.35s var(--dev-ease);
  }

  .dev-hero-cta:hover,
  .dev-hero-cta:focus-visible {
    transform: translateY(-4px);
    box-shadow: 9px 10px 0 rgb(251 250 247 / 0.16);
  }

  .dev-hero-cta:hover span,
  .dev-hero-cta:focus-visible span {
    transform: translate(4px, -3px);
  }

  /* --- Vertical descriptor --- */
  .dev-hero-side-note {
    display: flex;
    align-items: center;
    align-self: end;
    justify-self: end;
    gap: 0.6rem;
    margin-block-end: 1rem;
    color: var(--dev-hero-meta);
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .dev-hero-side-note-dot {
    width: 7px;
    height: 7px;
    border: 1px solid currentcolor;
    border-radius: 50%;
    animation: dev-hero-dot-pulse 2.2s ease-in-out infinite;
  }

  /* --- Fit card --- */
  .dev-hero-fit-card {
    position: absolute;
    inset-inline-end: clamp(2rem, 4vw, 4rem);
    inset-block-end: clamp(6rem, 11vw, 9rem);
    z-index: 2;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    width: min(220px, 18vw);
    min-width: 190px;
    padding: 1.15rem 1.2rem 1.2rem;
    color: var(--color-foreground);
    border: 1px solid rgb(251 250 247 / 0.9);
    background: rgb(251 250 247 / 0.9);
    box-shadow: 10px 12px 0 rgb(251 250 247 / 0.16);
    text-decoration: none;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    transition: color 0.35s var(--dev-ease), background 0.35s var(--dev-ease),
      transform 0.35s var(--dev-ease), box-shadow 0.35s var(--dev-ease);
  }

  .dev-hero-fit-card:hover,
  .dev-hero-fit-card:focus-visible {
    color: var(--color-background);
    background: rgb(var(--color-foreground-rgb) / 0.84);
    transform: translateY(-6px);
    box-shadow: 14px 16px 0 rgb(251 250 247 / 0.2);
  }

  .dev-hero-fit-card-kicker {
    margin-block-end: 0.9rem;
    color: var(--dev-olive);
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .dev-hero-fit-card:hover .dev-hero-fit-card-kicker,
  .dev-hero-fit-card:focus-visible .dev-hero-fit-card-kicker {
    color: var(--dev-hero-accent);
  }

  .dev-hero-fit-card-title {
    font-family: var(--dev-font-display);
    font-size: 28px;
    font-weight: 500;
    line-height: 0.94;
    letter-spacing: -0.045em;
  }

  .dev-hero-fit-card-title em {
    color: var(--dev-olive);
    font-style: italic;
  }

  .dev-hero-fit-card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    margin-block-start: 1.4rem;
    padding-block-end: 0.3rem;
    border-block-end: 1px solid currentcolor;
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .dev-hero-fit-card-link b {
    font-size: 14px;
    font-weight: 400;
    transition: transform 0.3s var(--dev-ease);
  }

  .dev-hero-fit-card:hover .dev-hero-fit-card-link b,
  .dev-hero-fit-card:focus-visible .dev-hero-fit-card-link b {
    transform: translate(3px, -3px);
  }

  /* --- Bottom rule --- */
  .dev-hero-bottomline {
    display: grid;
    grid-template-columns: minmax(130px, 0.48fr) minmax(0, 2fr) auto;
    gap: clamp(1.2rem, 3vw, 3.5rem);
    align-items: end;
    padding-block-start: 1.1rem;
    border-block-start: 1px solid rgb(251 250 247 / 0.3);
  }

  .dev-hero-scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--dev-hero-meta);
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.11em;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .dev-hero-scroll span {
    font-size: 16px;
    animation: dev-hero-scroll-nudge 1.8s ease-in-out infinite;
  }

  .dev-hero-moment-nav {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(0, 1fr);
    gap: clamp(0.7rem, 2vw, 2rem);
  }

  .dev-hero-moment {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto 2px;
    gap: 0.5rem 0.7rem;
    min-width: 0;
    padding: 0;
    color: rgb(251 250 247 / 0.56);
    border: 0;
    background: transparent;
    text-align: left;
    cursor: pointer;
    transition: color 0.3s var(--dev-ease);
  }

  .dev-hero-moment:hover,
  .dev-hero-moment:focus-visible,
  .dev-hero-moment.is-active {
    color: var(--dev-hero-text);
  }

  .dev-hero-moment:focus-visible {
    outline: 1px solid var(--dev-hero-text);
    outline-offset: 6px;
  }

  .dev-hero-moment-number {
    color: var(--dev-hero-meta);
    font-family: var(--dev-font-label);
    font-size: 9px;
  }

  .dev-hero-moment-label {
    overflow: hidden;
    font-family: var(--dev-font-label);
    font-size: 9px;
    letter-spacing: 0.1em;
    text-overflow: ellipsis;
    text-transform: uppercase;
    white-space: nowrap;
  }

  /* Progress rule that fills while its moment plays. */
  .dev-hero-moment-line {
    grid-column: 1 / -1;
    display: block;
    overflow: hidden;
    background: rgb(251 250 247 / 0.26);
  }

  .dev-hero-moment-line i {
    display: block;
    width: 0;
    height: 100%;
    background: var(--dev-hero-accent);
    transition: width 0.7s var(--dev-ease);
  }

  .dev-hero-moment.is-active .dev-hero-moment-line i {
    width: 100%;
  }

  .dev-hero-index {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    color: var(--dev-hero-meta);
    font-family: var(--dev-font-label);
    font-size: 10px;
    white-space: nowrap;
  }

  .dev-hero-index i {
    width: 32px;
    height: 1px;
    background: currentcolor;
  }

  @keyframes dev-hero-word-in {
    from {
      opacity: 0;
      transform: translateY(0.32em) rotate(1.5deg);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @keyframes dev-hero-dot-pulse {
    0%,
    100% {
      box-shadow: 0 0 0 0 rgb(220 226 199 / 0);
    }

    50% {
      box-shadow: 0 0 0 5px rgb(220 226 199 / 0.13);
    }
  }

  @keyframes dev-hero-scroll-nudge {
    0%,
    100% {
      transform: translateY(0);
    }

    50% {
      transform: translateY(6px);
    }
  }

  @media screen and (max-width: 900px) {
    .dev-hero {
      --dev-hero-title-size: clamp(3.4rem, 8vw, 6.5rem);
    }

    .dev-hero-grid {
      grid-template-columns: minmax(0, 1fr) minmax(130px, 0.24fr);
      gap: 2rem;
    }

    .dev-hero-bottomline {
      grid-template-columns: minmax(100px, 0.38fr) minmax(0, 2fr) auto;
      gap: 1rem;
    }

    .dev-hero-fit-card {
      display: none;
    }
  }

  @media screen and (max-width: 680px) {
    .dev-hero {
      --dev-hero-title-size: clamp(3rem, 12vw, 4.5rem);
    }

    .dev-hero,
    .dev-hero-container {
      min-height: max(var(--dev-hero-min-height-mobile), calc(100svh - var(--dev-hero-offset)));
    }

    .dev-hero-container {
      padding-block: 1rem 1.3rem;
    }

    .dev-hero-topline {
      padding-block-end: 0.9rem;
    }

    .dev-hero-topline-note {
      display: none;
    }

    .dev-hero-grid {
      display: flex;
      flex: 1;
      align-items: flex-end;
      padding-block: 5rem 2.6rem;
    }

    .dev-hero-copy {
      max-width: 100%;
    }

    .dev-hero-copy-eyebrow {
      margin-block-end: 1rem;
    }

    .dev-hero-title {
      max-width: 520px;
      margin-block-end: 1.3rem;
    }

    .dev-hero-text {
      max-width: 360px;
      margin-block-end: 1.7rem;
    }

    .dev-hero-side-note {
      display: none;
    }

    .dev-hero-bottomline {
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 1rem;
      padding-block-start: 0.9rem;
    }

    .dev-hero-scroll {
      display: none;
    }

    .dev-hero-moment-nav {
      grid-column: 1 / -1;
      grid-row: 1;
      gap: 0.7rem;
    }

    .dev-hero-index {
      grid-column: 2;
      grid-row: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .dev-hero-title-word {
      opacity: 1;
      transform: none;
      animation: none;
    }

    .dev-hero-media,
    .dev-hero-video,
    .dev-hero-copy > *,
    .dev-hero-cta,
    .dev-hero-moment,
    .dev-hero-moment-line i {
      transition: none;
    }

    .dev-hero-side-note-dot,
    .dev-hero-scroll span {
      animation: none;
    }
  }
{% endstylesheet %}

{% schema %}
