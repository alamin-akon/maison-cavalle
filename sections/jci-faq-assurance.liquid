{% comment %}
  Maison Cavallé — FAQ assurance cards

  Prototype source: maison-cavalle-main/index.html  → section.faq-assurance
                    maison-cavalle-main/styles.css  → .faq-assurance
                                                      (1043-1053), @680 block
  Reference: MAISON-CAVALLE-SPEC.md §1, §3, §5, §7

  One §0 note on the prototype: styles.css:1052 pins the arrow with
  `.faq-assurance-card > .action-arrow`, a direct-child selector, but the
  markup nests the arrow inside a `<b>` — so as authored that rule never
  matches and the arrow falls into the flow. The intent is plainly the pinned
  arrow, so the class goes straight on the arrow here and the rule applies as
  written, with no wrapper in between.

  Per §0 no letter-spacing or line-height is authored and the `font:`
  shorthands are split. Colours are palette entries or opacity steps (§7).
{% endcomment %}

{%- liquid
  assign s = section.settings
  assign cards = section.blocks | where: 'type', 'card'
-%}

<section
  class="jci-faq-assurance"
  {% if s.anchor_id != blank %}id="{{ s.anchor_id }}"{% endif %}
  {{ section.shopify_attributes }}
  style="
    --jci-faq-assurance-bg: {{ s.background_color | default: settings.color_palette.color5 }};
    --jci-faq-assurance-text: {{ s.text_color | default: settings.color_palette.background }};
    --jci-faq-assurance-accent: {{ s.accent_color | default: settings.color_palette.color7 }};
    --jci-faq-assurance-body: {% if s.body_color != blank %}{{ s.body_color }}{% else %}rgb(var(--jci-paper-rgb) / 0.82){% endif %};
    --jci-faq-assurance-hover-bg: {{ s.hover_background | default: settings.color_palette.background }};
    --jci-faq-assurance-hover-text: {{ s.hover_text_color | default: settings.color_palette.foreground }};
    --jci-faq-assurance-hover-meta: {{ s.hover_meta_color | default: settings.color_palette.color5 }};
    --jci-faq-assurance-card-min-height: {{ s.card_min_height }}px;
    --jci-faq-assurance-card-min-height-mobile: {{ s.card_min_height_mobile }}px;
    --jci-faq-assurance-lift: {{ s.hover_lift }}px;
    --jci-faq-assurance-pad-top: {{ s.padding_top }}px;
    --jci-faq-assurance-pad-bottom: {{ s.padding_bottom }}px;
    --jci-faq-assurance-pad-top-mobile: {{ s.padding_top_mobile }}px;
    --jci-faq-assurance-pad-bottom-mobile: {{ s.padding_bottom_mobile }}px;
  "
>
  <div class="jci-faq-assurance-container">
    <div class="jci-faq-assurance-intro">
      {%- if s.eyebrow != blank -%}
        <p class="jci-eyebrow jci-faq-assurance-eyebrow">{{ s.eyebrow }}</p>
      {%- endif -%}
      {%- if s.title != blank -%}
        <h2 class="jci-faq-assurance-title">{{ s.title }}</h2>
      {%- endif -%}
    </div>

    {%- if cards.size > 0 -%}
      <div class="jci-faq-assurance-grid">
        {%- for block in cards -%}
          {%- assign card = block.settings -%}
          <a
            class="jci-faq-assurance-card"
            href="{{ card.link | default: '#' }}"
            {{ block.shopify_attributes }}
          >
            <span class="jci-faq-assurance-card-index">
              {{- card.index | default: forloop.index | prepend: '0' | slice: -2, 2 -}}
            </span>

            {%- if card.title != blank -%}
              <strong class="jci-faq-assurance-card-title">{{ card.title }}</strong>
            {%- endif -%}

            {%- if card.text != blank -%}
              <p class="jci-faq-assurance-card-text">{{ card.text }}</p>
            {%- endif -%}

            {%- render 'jci-action-arrow', class: 'jci-faq-assurance-card-arrow' -%}
          </a>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

{% stylesheet %}
  /* styles.css:1043 */
  .jci-faq-assurance {
    color: var(--jci-faq-assurance-text);
    background: var(--jci-faq-assurance-bg);
  }

  .jci-faq-assurance-container {
    display: grid;
    grid-template-columns: 0.7fr 1.3fr;
    gap: clamp(2rem, 7vw, 8rem);
    padding-block: var(--jci-faq-assurance-pad-top) var(--jci-faq-assurance-pad-bottom);
  }

  /* styles.css:1044-1045 */
  .jci-faq-assurance-eyebrow {
    color: var(--jci-faq-assurance-accent);
  }

  .jci-faq-assurance-title {
    max-width: 340px;
    margin: 1rem 0 0;
    font-family: var(--jci-font-display);
    font-size: var(--jci-section-title-size);
    font-weight: 500;
  }

  /* styles.css:1046 */
  .jci-faq-assurance-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.7rem;
  }

  /* styles.css:1047 */
  .jci-faq-assurance-card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: var(--jci-faq-assurance-card-min-height);
    padding: 1.2rem;
    color: inherit;
    border: 1px solid rgb(var(--jci-paper-rgb) / 0.28);
    text-decoration: none;
    transition:
      color 0.3s,
      background 0.3s,
      transform 0.4s var(--jci-ease);
  }

  /* styles.css:1048, 1053 */
  .jci-faq-assurance-card:hover,
  .jci-faq-assurance-card:focus-visible {
    color: var(--jci-faq-assurance-hover-text);
    background: var(--jci-faq-assurance-hover-bg);
    transform: translateY(calc(var(--jci-faq-assurance-lift) * -1));
  }

  /* styles.css:1049 */
  .jci-faq-assurance-card-index {
    color: var(--jci-faq-assurance-accent);
    font-family: var(--jci-font-label);
    font-size: 12px;
  }

  /* styles.css:1050 */
  .jci-faq-assurance-card-title {
    margin-block-start: auto;
    font-family: var(--jci-font-display);
    font-size: 22px;
    font-weight: 500;
  }

  /* styles.css:1051 */
  .jci-faq-assurance-card-text {
    margin: 0.55rem 0 0;
    color: var(--jci-faq-assurance-body);
    font-family: var(--jci-font-sans);
    font-size: var(--jci-subtitle-size);
  }

  .jci-faq-assurance-card:hover .jci-faq-assurance-card-text,
  .jci-faq-assurance-card:hover .jci-faq-assurance-card-index,
  .jci-faq-assurance-card:focus-visible .jci-faq-assurance-card-text,
  .jci-faq-assurance-card:focus-visible .jci-faq-assurance-card-index {
    color: var(--jci-faq-assurance-hover-meta);
  }

  /* styles.css:1052 — pinned, per the §0 note at the top of this file. */
  .jci-faq-assurance-card > .jci-faq-assurance-card-arrow {
    position: absolute;
    right: 1.2rem;
    bottom: 1.2rem;
    width: 18px;
    height: 18px;
  }

  /* styles.css:@680 — the intro stacks above a single column of cards. */
  @media screen and (max-width: 680px) {
    .jci-faq-assurance-container {
      display: block;
      padding-block: var(--jci-faq-assurance-pad-top-mobile) var(--jci-faq-assurance-pad-bottom-mobile);
    }

    .jci-faq-assurance-intro {
      margin-block-end: 2rem;
    }

    .jci-faq-assurance-grid {
      grid-template-columns: 1fr;
    }

    .jci-faq-assurance-card {
      min-height: var(--jci-faq-assurance-card-min-height-mobile);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .jci-faq-assurance-card {
      transition: none;
    }

    .jci-faq-assurance-card:hover,
    .jci-faq-assurance-card:focus-visible {
      transform: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "FAQ assurance",
  "tag": "section",
  "class": "jci-faq-assurance-section",
  "max_blocks": 6,
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        { "type": "text", "id": "index", "label": "Number", "info": "Leave empty to number automatically." },
        { "type": "text", "id": "title", "label": "Title", "default": "Shipping & returns" },
        { "type": "textarea", "id": "text", "label": "Body", "default": "Simple delivery, clear next steps." },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "settings": [
    { "type": "header", "content": "Intro" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The Maison promise" },
    { "type": "text", "id": "title", "label": "Title", "default": "Small details. A smoother day." },

    { "type": "header", "content": "Cards" },
    { "type": "range", "id": "card_min_height", "label": "Card height", "min": 100, "max": 400, "step": 10, "unit": "px", "default": 180 },
    { "type": "range", "id": "card_min_height_mobile", "label": "Card height on mobile", "min": 80, "max": 320, "step": 5, "unit": "px", "default": 145 },
    { "type": "range", "id": "hover_lift", "label": "Hover lift", "min": 0, "max": 20, "step": 1, "unit": "px", "default": 5 },

    { "type": "header", "content": "Colors", "info": "Left empty, each of these follows the theme colour palette." },
    { "type": "color", "id": "background_color", "label": "Background" },
    { "type": "color", "id": "text_color", "label": "Text" },
    { "type": "color", "id": "accent_color", "label": "Accent" },
    { "type": "color", "id": "body_color", "label": "Card body" },
    { "type": "color", "id": "hover_background", "label": "Card hover background" },
    { "type": "color", "id": "hover_text_color", "label": "Card hover text" },
    { "type": "color", "id": "hover_meta_color", "label": "Card hover metadata" },

    { "type": "header", "content": "Layout" },
    { "type": "range", "id": "padding_top", "label": "Padding top", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom", "min": 0, "max": 240, "step": 4, "unit": "px", "default": 136 },
    { "type": "range", "id": "padding_top_mobile", "label": "Padding top on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },
    { "type": "range", "id": "padding_bottom_mobile", "label": "Padding bottom on mobile", "min": 0, "max": 160, "step": 4, "unit": "px", "default": 72 },

    { "type": "header", "content": "Anchor" },
    { "type": "text", "id": "anchor_id", "label": "Anchor ID", "default": "faq-assurance" }
  ],
  "presets": [
    {
      "name": "FAQ assurance",
      "blocks": [
        { "type": "card", "settings": { "index": "01", "title": "Shipping & returns", "text": "Simple delivery, clear next steps." } },
        { "type": "card", "settings": { "index": "02", "title": "Find your fit", "text": "Measurements and guidance, made easy." } },
        { "type": "card", "settings": { "index": "03", "title": "Ask the Maison", "text": "Personal help when you need it." } }
      ]
    }
  ]
}
{% endschema %}
